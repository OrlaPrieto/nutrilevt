---
import SpeedInsights from "@vercel/speed-insights/astro";
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Recetario Navideño 2026 · Edición Clínica VIP | Nutrilev",
  description = "185 recetas navideñas con respaldo clínico, porciones controladas y conteo de equivalentes SMAE por la Nutrióloga Velvet De la Cruz."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nutrilev.com');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon2.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Plus Jakarta Sans (super legible body/UI) and Playfair Display (warm elegant headers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --color-nav-burgundy: #6e1026;
        --color-nav-burgundy-dark: #540c1d;
        --color-nav-burgundy-light: #8b1834;
        --color-nav-emerald: #15803d;
        --color-nav-gold: #b45309;
        --color-nav-gold-light: #f59e0b;
        --color-nav-bg: #fbf9f5;
        --color-nav-card-bg: #ffffff;
        --color-nav-border: #ede8df;
        --color-nav-text: #1a1514;
        --color-nav-muted: #6b635f;
      }

      body.recetario-body {
        background-color: var(--color-nav-bg);
        color: var(--color-nav-text);
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        margin: 0;
        padding: 0;
      }

      .font-display {
        font-family: 'Playfair Display', Georgia, serif;
      }

      .font-sans-recetario {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      }

      .font-mono-recetario {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      /* Custom print styles for single recipe cards */
      @media print {
        header, nav, #filter-section, #vip-banner, #footer-editorial, .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          color: #000000 !important;
        }
        #recipe-modal {
          position: static !important;
          background: none !important;
          padding: 0 !important;
        }
        #recipe-modal-dialog {
          box-shadow: none !important;
          border: none !important;
          max-width: 100% !important;
          width: 100% !important;
        }
      }
    </style>
  </head>
  <body class="recetario-body min-h-screen flex flex-col selection:bg-[#881337] selection:text-white">
    <slot />
    <SpeedInsights />
  </body>
</html>
