---
// Modales, drawer de filtros y notificación toast para el Recetario Navideño 2026
---

<!-- MODAL DE DETALLE DE RECETA (Bottom-sheet en móvil con cabecera sticky) -->
<div
  id="recipe-modal"
  class="fixed inset-0 z-[60] hidden bg-black/80 backdrop-blur-md p-0 sm:p-6 lg:p-10 flex items-end sm:items-center justify-center overflow-y-auto font-sans-recetario"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    id="recipe-modal-dialog"
    class="rounded-t-3xl sm:rounded-3xl border-t sm:border border-[#E6A635]/35 bg-[#2B050D] px-5 pb-6 sm:px-9 sm:pb-9 shadow-[0_15px_60px_rgba(0,0,0,0.85)] w-full max-w-4xl sm:my-auto relative max-h-[92vh] sm:max-h-[90vh] overflow-y-auto text-white"
  >
    <!-- Sticky Close Bar -->
    <div class="sticky top-0 z-10 bg-[#2B050D]/95 backdrop-blur-md -mx-5 sm:-mx-9 px-5 sm:px-9 pt-3 sm:pt-5 pb-3.5 mb-5 border-b border-[#E6A635]/20">
      <div class="w-10 h-1 rounded-full bg-[#E6A635]/35 mx-auto mb-3 sm:hidden"></div>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span
            id="modal-category"
            class="text-xs font-semibold uppercase px-3 py-1 rounded-full border bg-[#E6A635]/15 text-[#F5D061] border-[#E6A635]/30"
          ></span>
          <span class="text-[#E6A635]/40">·</span>
          <span
            id="modal-page"
            class="font-mono-recetario text-xs text-[#E6A635]"
          ></span>
        </div>
        <button
          id="btn-close-modal"
          type="button"
          aria-label="Cerrar ficha de receta"
          class="w-9 h-9 rounded-full bg-[#1E0308] hover:bg-[#E6A635] text-[#F5D061] hover:text-[#28050D] flex items-center justify-center font-bold text-sm transition-all border border-[#E6A635]/40 hover:rotate-90 cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Top Section with Photo -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-7 items-center mb-7 sm:mb-8">
      <div class="md:col-span-5">
        <div class="relative w-full h-56 sm:h-72 rounded-2xl overflow-hidden bg-[#1E0308] border border-[#E6A635]/25 shadow-lg">
          <img
            id="modal-image"
            src=""
            alt=""
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#2B050D]/60 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </div>

      <div class="md:col-span-7">
        <h2
          id="modal-title"
          class="font-script text-3xl sm:text-[42px] lg:text-5xl text-[#F5D061] font-bold leading-tight mb-4"
        ></h2>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-3 gap-2 py-3 border-y border-[#E6A635]/20 text-center mb-5">
          <div>
            <span
              id="modal-portions"
              class="block font-bold text-lg text-[#F5D061] font-mono-recetario"
            ></span>
            <span class="text-[10px] text-amber-200/75 uppercase font-medium block">
              porciones
            </span>
          </div>
          <div class="border-x border-[#E6A635]/20">
            <span
              id="modal-calories"
              class="block font-bold text-lg text-[#F5D061] font-mono-recetario"
            ></span>
            <span class="text-[10px] text-amber-200/75 uppercase font-medium block">
              kcal
            </span>
          </div>
          <div>
            <span
              id="modal-time"
              class="block font-bold text-lg text-[#F5D061] font-mono-recetario truncate"
            ></span>
            <span class="text-[10px] text-amber-200/75 uppercase font-medium block truncate">
              tiempo est.
            </span>
          </div>
        </div>

        <!-- Nutritional Breakdown (Editorial uniforme con indicadores de color) -->
        <div class="p-4 bg-[#1E0308] border border-[#E6A635]/25 rounded-2xl">
          <span class="text-[11px] font-semibold text-[#E6A635] uppercase tracking-wider block mb-2.5">
            Información Nutricional por Porción
          </span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <div class="p-2.5 bg-[#28050D]/80 border border-[#E6A635]/20 rounded-xl">
              <span class="flex items-center gap-1.5 text-[10px] uppercase font-medium text-amber-100/80 mb-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Proteína</span>
              </span>
              <span
                id="modal-prot"
                class="font-bold font-mono-recetario text-sm text-white"
              ></span>
            </div>
            <div class="p-2.5 bg-[#28050D]/80 border border-[#E6A635]/20 rounded-xl">
              <span class="flex items-center gap-1.5 text-[10px] uppercase font-medium text-amber-100/80 mb-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span>Grasas</span>
              </span>
              <span
                id="modal-fat"
                class="font-bold font-mono-recetario text-sm text-white"
              ></span>
            </div>
            <div class="p-2.5 bg-[#28050D]/80 border border-[#E6A635]/20 rounded-xl">
              <span class="flex items-center gap-1.5 text-[10px] uppercase font-medium text-amber-100/80 mb-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                <span>Carbohidratos</span>
              </span>
              <span
                id="modal-carb"
                class="font-bold font-mono-recetario text-sm text-white"
              ></span>
            </div>
            <div class="p-2.5 bg-[#28050D]/80 border border-[#E6A635]/20 rounded-xl">
              <span class="flex items-center gap-1.5 text-[10px] uppercase font-medium text-amber-100/80 mb-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
                <span>Fibra</span>
              </span>
              <span
                id="modal-fib"
                class="font-bold font-mono-recetario text-sm text-white"
              ></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SMAE Clinical Equivalents Table -->
    <div id="modal-equivalents-section" class="mb-6 hidden">
      <div class="text-xs font-semibold text-[#F5D061] uppercase tracking-wider mb-3 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E6A635]"></span>
        <span>Sistema Mexicano de Alimentos Equivalentes (SMAE)</span>
      </div>
      <div
        id="modal-equivalents-list"
        class="grid grid-cols-2 sm:grid-cols-4 gap-2.5"
      >
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Ingredients & Steps -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-7 mb-6">
      <!-- Ingredients with Checkboxes -->
      <div class="md:col-span-5 bg-[#1E0308] p-5 sm:p-6 rounded-2xl border border-[#E6A635]/25">
        <div class="text-xs font-semibold text-[#F5D061] uppercase tracking-wider mb-3.5 pb-2 border-b border-[#E6A635]/20 flex items-center justify-between">
          <span>Ingredientes</span>
          <span class="text-[10px] text-amber-200/70 font-normal">
            (Toca para tachar)
          </span>
        </div>
        <ul
          id="modal-ingredients-list"
          class="space-y-2.5 text-xs text-amber-100/90"
        >
          <!-- Injected via JS -->
        </ul>
      </div>

      <!-- Numbered Instructions -->
      <div class="md:col-span-7 bg-[#1E0308] p-5 sm:p-6 rounded-2xl border border-[#E6A635]/25">
        <div class="text-xs font-semibold text-[#F5D061] uppercase tracking-wider mb-3.5 pb-2 border-b border-[#E6A635]/20">
          Procedimiento Paso a Paso
        </div>
        <ol
          id="modal-instructions-list"
          class="space-y-3.5 text-xs text-amber-100"
        >
          <!-- Injected via JS -->
        </ol>
      </div>
    </div>

    <!-- Nutri Tip if present -->
    <div
      id="modal-tip-box"
      class="hidden mb-6 p-4 bg-[#1E0308] border-l-2 border-[#F5D061] rounded-r-2xl border border-r-[#E6A635]/20 border-y-[#E6A635]/20"
    >
      <span class="text-xs font-semibold uppercase tracking-wider text-[#F5D061] flex items-center gap-1.5 mb-1.5">
        <svg
          class="w-4 h-4 text-[#F5D061]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.509 1.333 1.509 2.316V18"
          />
        </svg>
        <span>Consejo Clínico de tu Nutrióloga</span>
      </span>
      <p
        id="modal-tip-text"
        class="text-xs text-amber-100/85 leading-relaxed font-light"
      ></p>
    </div>

    <!-- Modal Actions -->
    <div class="pt-5 border-t border-[#E6A635]/20 flex items-center justify-end no-print">
      <button
        id="btn-close-modal-bottom"
        type="button"
        class="text-xs font-bold px-7 py-2.5 bg-gradient-to-r from-[#E6A635] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] rounded-xl transition-all shadow-md cursor-pointer"
      >
        Cerrar Ficha
      </button>
    </div>
  </div>
</div>

<!-- VIP CODE UNLOCK MODAL -->
<div
  id="unlock-modal"
  class="fixed inset-0 z-[60] hidden bg-black/80 backdrop-blur-md p-4 flex items-center justify-center font-sans-recetario"
  role="dialog"
  aria-modal="true"
  aria-labelledby="unlock-modal-title"
>
  <div class="w-full max-w-md rounded-2xl border border-[#E6A635]/35 bg-[#2B050D] p-6 sm:p-8 shadow-2xl relative text-white">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#E6A635]/20">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#F5D061] flex items-center gap-2">
        <svg
          class="w-4 h-4 text-[#F5D061]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
          />
        </svg>
        <span>Acceso Privado</span>
      </span>
      <button
        id="btn-close-unlock-modal"
        type="button"
        aria-label="Cerrar ventana de acceso"
        class="w-8 h-8 rounded-full bg-[#1E0308] hover:bg-[#E6A635] text-[#F5D061] hover:text-[#28050D] flex items-center justify-center font-bold text-xs transition-colors cursor-pointer"
      >
        ✕
      </button>
    </div>

    <h3 id="unlock-modal-title" class="font-display text-2xl text-white font-bold leading-snug mb-2">
      Ingresa tu código de acceso VIP
    </h3>
    <p class="text-xs text-amber-100/75 leading-relaxed mb-6 font-light">
      Introduce el código que recibiste al adquirir tu Recetario Navideño 2026
      para desbloquear las 185 recetas completas.
    </p>

    <form id="unlock-form" class="space-y-4">
      <div>
        <label
          for="vip-input-code"
          class="block text-xs font-semibold uppercase tracking-wider text-[#E6A635] mb-2"
        >
          Código de Desbloqueo
        </label>
        <input
          type="text"
          id="vip-input-code"
          required
          autocomplete="off"
          placeholder="Ingresa tu código de acceso"
          class="w-full h-12 px-4 bg-[#1E0308] border border-[#E6A635]/40 text-sm font-semibold text-[#F5D061] focus:outline-none focus:border-[#F5D061] focus:ring-2 focus:ring-[#E6A635]/30 rounded-xl transition-all tracking-wider placeholder-amber-200/45"
        />
      </div>

      <div
        id="unlock-error"
        class="hidden p-3 bg-red-950/70 border border-red-500/60 rounded-xl text-xs font-semibold text-red-200"
      >
        Código no válido. Verifica tu contraseña o solicita asistencia vía
        WhatsApp.
      </div>

      <button
        type="submit"
        class="w-full py-3.5 px-4 bg-gradient-to-r from-[#E6A635] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md cursor-pointer active:scale-[0.98]"
      >
        Activar Acceso Completo
      </button>
    </form>

    <div class="mt-6 pt-4 border-t border-[#E6A635]/20 text-center">
      <span class="block text-xs text-amber-100/75 mb-2 font-light">
        ¿Aún no has adquirido el recetario?
      </span>
      <a
        href="https://wa.me/526143958598?text=Hola%20Nutri%C3%B3loga%20Velvet,%20quiero%20comprar%20mi%20c%C3%B3digo%20de%20acceso%20para%20el%20Recetario%20Navide%C3%B1o%202026."
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold text-[#25D366] hover:text-[#20ba59] hover:underline inline-flex items-center gap-1.5"
      >
        <svg
          class="w-3.5 h-3.5 fill-current shrink-0"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span>Comprar acceso por WhatsApp →</span>
      </a>
    </div>
  </div>
</div>

<!-- MODAL DE CONFIRMACIÓN PARA CERRAR SESIÓN -->
<div
  id="logout-modal"
  class="fixed inset-0 z-[60] hidden bg-black/80 backdrop-blur-md p-4 flex items-center justify-center font-sans-recetario"
  role="dialog"
  aria-modal="true"
  aria-labelledby="logout-modal-title"
>
  <div class="w-full max-w-sm rounded-2xl border border-[#E6A635]/35 bg-[#2B050D] p-6 sm:p-7 shadow-2xl text-center text-white relative">
    <div class="w-12 h-12 rounded-xl bg-[#E6A635]/10 border border-[#E6A635]/30 text-[#F5D061] flex items-center justify-center mx-auto mb-4">
      <svg
        class="w-5 h-5 text-[#F5D061]"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
        />
      </svg>
    </div>
    <h3 id="logout-modal-title" class="font-display text-xl text-white font-bold mb-2">
      ¿Cerrar sesión VIP?
    </h3>
    <p class="text-xs text-amber-100/75 leading-relaxed mb-6 font-light">
      Para volver a consultar las recetas bloqueadas tendrás que ingresar
      nuevamente tu código de acceso.
    </p>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="btn-cancel-logout"
        class="flex-1 py-2.5 px-4 bg-[#1E0308] hover:bg-[#340811] border border-[#E6A635]/35 text-amber-100 text-xs font-semibold rounded-xl transition-colors cursor-pointer"
      >
        Cancelar
      </button>
      <button
        type="button"
        id="btn-confirm-logout"
        class="flex-1 py-2.5 px-4 bg-gradient-to-r from-[#991B32] to-[#800F24] hover:from-[#A51F38] hover:to-[#A51F38] text-white text-xs font-semibold rounded-xl transition-all shadow-md cursor-pointer"
      >
        Sí, cerrar sesión
      </button>
    </div>
  </div>
</div>

<!-- FILTROS AVANZADOS: BOTTOM SHEET EN MÓVIL Y MODAL CENTRADO EN ESCRITORIO -->
<div
  id="filters-drawer-backdrop"
  class="fixed inset-0 z-[60] hidden bg-black/60 backdrop-blur-sm transition-all duration-300 font-sans-recetario flex items-end sm:items-center justify-center p-0 sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="filters-drawer-title"
>
  <div
    id="filters-drawer-panel"
    class="relative w-full sm:max-w-xl max-h-[88vh] sm:max-h-[82vh] bg-[#22040B] border-t sm:border border-[#E6A635]/40 rounded-t-[28px] sm:rounded-3xl shadow-[0_-15px_50px_rgba(0,0,0,0.85)] sm:shadow-[0_20px_60px_rgba(0,0,0,0.9)] flex flex-col text-white transform translate-y-full sm:translate-y-0 sm:scale-95 sm:opacity-0 transition-all duration-300 ease-out"
  >
    <!-- Drag Handle / Visual pill (Solo visible en móvil) -->
    <div class="pt-3 pb-1 flex justify-center sm:hidden">
      <div class="w-12 h-1.5 rounded-full bg-[#E6A635]/40"></div>
    </div>

    <!-- Drawer Header -->
    <div class="px-5 py-3 border-b border-[#E6A635]/20 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-full bg-[#E6A635]/15 border border-[#E6A635]/30 text-[#F5D061] flex items-center justify-center text-sm shadow-inner">
          <svg
            class="w-4 h-4 text-[#F5D061]"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"
            />
          </svg>
        </span>
        <div>
          <h3 id="filters-drawer-title" class="font-display text-lg font-bold text-white">
            Filtros de Recetas
          </h3>
          <span class="text-[11px] text-amber-200/75 block font-light">
            Refina por calorías, nutrición y acceso
          </span>
        </div>
      </div>
      <button
        id="btn-close-filters-drawer"
        type="button"
        aria-label="Cerrar filtros"
        class="w-8 h-8 rounded-full bg-[#1E0308] hover:bg-[#E6A635] text-[#F5D061] hover:text-[#28050D] flex items-center justify-center font-bold text-xs transition-colors cursor-pointer"
        title="Cerrar filtros"
      >
        ✕
      </button>
    </div>

    <!-- Drawer Scrollable Content -->
    <div class="px-5 py-4 overflow-y-auto space-y-6 flex-1 text-xs">
      <!-- Bloque 1: Tipo de Acceso -->
      <div>
        <span class="font-bold text-[11px] uppercase tracking-wider text-[#E6A635] block mb-2.5">
          Tipo de Acceso
        </span>
        <button
          type="button"
          id="drawer-free-toggle"
          class="w-full p-3 rounded-2xl border flex items-center justify-between transition-all bg-[#1E0308] border-[#E6A635]/30 text-amber-100 cursor-pointer active:scale-[0.98]"
        >
          <div class="flex items-center gap-2.5">
            <span
              id="drawer-free-dot"
              class="w-2.5 h-2.5 rounded-full bg-slate-500"
            ></span>
            <span class="font-semibold text-xs text-left">
              Solo recetas de Muestra Libre
            </span>
          </div>
          <span class="text-[11px] font-mono-recetario px-2.5 py-0.5 rounded-full bg-emerald-950/90 text-emerald-300 border border-emerald-400/40">
            6 recetas
          </span>
        </button>
      </div>

      <!-- Bloque 2: Rango Calórico -->
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <span class="font-bold text-[11px] uppercase tracking-wider text-[#E6A635]">
            Calorías por porción
          </span>
          <span
            id="drawer-calories-label"
            class="text-[11px] text-[#F5D061] font-mono-recetario"
          >
            Todas
          </span>
        </div>
        <div
          class="grid grid-cols-2 sm:grid-cols-4 gap-2"
          id="drawer-calories-grid"
        >
          <button
            type="button"
            data-cal-range="all"
            class="cal-pill-btn p-2.5 rounded-xl border text-center font-semibold transition-all bg-[#E6A635] text-[#28050D] border-[#FFF0C0] shadow-sm cursor-pointer"
          >
            Cualquier caloría
          </button>
          <button
            type="button"
            data-cal-range="under100"
            class="cal-pill-btn p-2.5 rounded-xl border text-center font-semibold transition-all bg-[#1E0308] text-amber-100/90 border-[#E6A635]/30 hover:border-[#F5D061] cursor-pointer"
          >
            Menos de 100 kcal
          </button>
          <button
            type="button"
            data-cal-range="100to200"
            class="cal-pill-btn p-2.5 rounded-xl border text-center font-semibold transition-all bg-[#1E0308] text-amber-100/90 border-[#E6A635]/30 hover:border-[#F5D061] cursor-pointer"
          >
            100 a 200 kcal
          </button>
          <button
            type="button"
            data-cal-range="over200"
            class="cal-pill-btn p-2.5 rounded-xl border text-center font-semibold transition-all bg-[#1E0308] text-amber-100/90 border-[#E6A635]/30 hover:border-[#F5D061] cursor-pointer"
          >
            Más de 200 kcal
          </button>
        </div>
      </div>

      <!-- Bloque 3: Etiquetas Clínicas y Nutricionales -->
      <div>
        <span class="font-bold text-[11px] uppercase tracking-wider text-[#E6A635] block mb-2.5">
          Etiquetas Clínicas y Saludables
        </span>
        <div class="flex flex-wrap gap-2" id="drawer-tags-container">
          {[
            "Sin azúcar añadida",
            "Baja en grasa",
            "Rica en proteína",
            "Con fibra",
            "Con fruta",
            "Ligero",
            "Receta casera",
          ].map((tag) => (
            <button
              type="button"
              data-drawer-tag={tag}
              class="drawer-tag-btn px-3.5 py-2 rounded-full border border-[#E6A635]/30 bg-[#1E0308] text-amber-100/90 font-medium text-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
            >
              <span class="tag-check opacity-0 inline-flex items-center">
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.5 12.75l6 6 9-13.5"
                  />
                </svg>
              </span>
              <span>{tag}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Drawer / Modal Fixed Footer Action Bar -->
    <div class="p-4 sm:p-5 border-t border-[#E6A635]/25 bg-[#1A0307] rounded-b-[28px] sm:rounded-b-3xl flex items-center gap-3 shrink-0">
      <button
        type="button"
        id="btn-drawer-reset"
        class="py-3 px-4 rounded-xl border border-[#E6A635]/40 bg-[#1E0308] hover:bg-[#340811] text-amber-100 font-bold text-xs transition-colors cursor-pointer shrink-0"
      >
        Limpiar
      </button>
      <button
        type="button"
        id="btn-drawer-apply"
        class="flex-1 py-3 px-5 rounded-xl bg-gradient-to-r from-[#E6A635] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] font-extrabold text-xs uppercase tracking-wider transition-all shadow-lg active:scale-[0.98] cursor-pointer text-center"
      >
        Aplicar Filtros (<span id="drawer-apply-count">185</span>)
      </button>
    </div>
  </div>
</div>

<!-- TOAST NOTIFICATION -->
<div
  id="toast-notification"
  class="fixed top-32 md:top-44 right-6 z-[60] transition-all duration-300 transform -translate-y-6 opacity-0 pointer-events-none max-w-sm font-sans-recetario"
>
  <div class="rounded-2xl border border-[#E6A635]/35 bg-[#2B050D]/95 backdrop-blur-md p-4 shadow-2xl flex items-center gap-3.5 text-white">
    <div class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-400/40 text-emerald-300 flex items-center justify-center shrink-0">
      <svg
        class="w-4 h-4 text-emerald-300"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 12.75l6 6 9-13.5"
        />
      </svg>
    </div>
    <div class="flex-1">
      <div id="toast-title" class="font-bold text-xs text-[#F5D061]">
        ¡Acceso VIP Activado!
      </div>
      <div
        id="toast-message"
        class="text-xs text-amber-100/80 mt-0.5 font-light"
      >
        Las 185 recetas han sido desbloqueadas con éxito.
      </div>
    </div>
    <button
      type="button"
      id="btn-close-toast"
      aria-label="Cerrar notificación"
      class="text-amber-200/70 hover:text-white text-xs font-bold p-1 cursor-pointer"
    >
      ✕
    </button>
  </div>
</div>
