---
export interface CategoryContour {
  border: string;
  glow: string;
  badge: string;
  accent: string;
  label: string;
}

export interface RecipeItem {
  id: string;
  title: string;
  category: string;
  categorySlug: string;
  calories: number;
  portions: string;
  prepTime: string;
  tags: string[];
  ingredients: string[];
  image?: string;
}

interface Props {
  recipe: RecipeItem;
  isFree: boolean;
  contour: CategoryContour;
}

const { recipe, isFree, contour } = Astro.props;
---

<article
  data-id={recipe.id}
  data-action="open-recipe"
  data-recipe-id={recipe.id}
  data-category={recipe.categorySlug}
  data-calories={recipe.calories}
  data-tags={recipe.tags.join("|")}
  data-title={recipe.title.toLowerCase()}
  data-ingredients={recipe.ingredients.join(" ").toLowerCase()}
  data-free={isFree ? "true" : "false"}
  tabindex="0"
  class={`recetario-card bg-[#28050D] rounded-2xl overflow-hidden border border-[#E6A635]/20 hover:border-[#F5D061]/55 hover:shadow-[0_14px_34px_rgba(0,0,0,0.6),0_0_24px_rgba(230,166,53,0.12)] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 group relative cursor-pointer ${!isFree ? "hidden" : ""}`}
>
  <!-- Top Dish Photo (Fusión suave con el cuerpo de la tarjeta) -->
  <div
    class="relative w-full h-52 sm:h-56 overflow-hidden bg-[#1E0308] cursor-pointer shrink-0"
    data-action="open-recipe"
    data-recipe-id={recipe.id}
  >
    {recipe.image ? (
      <img
        src={recipe.image}
        alt={recipe.title}
        width="640"
        height="448"
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/images/recetas/001-champurrado-ligero.webp';"
        class="w-full h-full object-cover group-hover:scale-105 motion-reduce:group-hover:scale-100 transition-transform duration-500 ease-out motion-reduce:transition-none"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-amber-200/70 text-xs">
        Fotografía de platillo
      </div>
    )}

    <!-- Overlay degradado que funde suavemente la foto hacia el fondo #28050D -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#28050D] via-[#28050D]/15 to-black/25 pointer-events-none"></div>

    <!-- Badges sobrios en vidrio oscuro sobre la fotografía -->
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5 z-10">
      <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-black/55 backdrop-blur-md text-white/95 border border-white/15 shadow-sm flex items-center gap-1.5">
        <span
          class="w-1.5 h-1.5 rounded-full"
          style={`background-color: ${contour.accent};`}
        ></span>
        <span>{recipe.category}</span>
      </span>
      {isFree && (
        <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-emerald-950/75 backdrop-blur-md text-emerald-300 border border-emerald-400/35 shadow-sm">
          Muestra libre
        </span>
      )}
    </div>
  </div>

  <!-- Card Content Body -->
  <div class="px-5 pb-5 pt-2 flex flex-col flex-1 justify-between">
    <div>
      <!-- Recipe Title (Playfair Display para lectura rápida y elegante) -->
      <h3
        data-action="open-recipe"
        data-recipe-id={recipe.id}
        class="font-display text-xl sm:text-[22px] text-[#F5D061] hover:text-white font-bold leading-snug mb-3 cursor-pointer transition-colors line-clamp-2 min-h-[3.25rem] sm:min-h-[3.5rem]"
      >
        {recipe.title}
      </h3>

      <!-- Fila limpia de métricas separada únicamente por líneas divisorias sutiles -->
      <div class="grid grid-cols-3 py-2.5 my-3 border-y border-[#E6A635]/15 text-center">
        <div>
          <span class="block font-bold text-base text-[#F5D061] font-mono-recetario">
            {recipe.portions.replace(/porci[oó]n(es)?/i, "").trim() || "1"}
          </span>
          <span class="text-[10px] text-amber-200/75 uppercase tracking-wider font-medium block">
            porciones
          </span>
        </div>
        <div class="border-x border-[#E6A635]/15">
          <span class="block font-bold text-base text-[#F5D061] font-mono-recetario">
            {recipe.calories || "150"}
          </span>
          <span class="text-[10px] text-amber-200/75 uppercase tracking-wider font-medium block">
            kcal
          </span>
        </div>
        <div>
          <span class="block font-bold text-base text-[#F5D061] font-mono-recetario truncate">
            {recipe.prepTime
              .replace(/prep\.? estimada|preparaci[oó]n/i, "")
              .trim()}
          </span>
          <span class="text-[10px] text-amber-200/75 uppercase tracking-wider font-medium block truncate">
            tiempo
          </span>
        </div>
      </div>

      <!-- Etiquetas Saludables: altura mínima uniforme para alinear filas -->
      <div class="flex flex-wrap items-center gap-1.5 my-2.5 min-h-[26px]">
        {recipe.tags && recipe.tags.length > 0 && (
          <>
            {recipe.tags.slice(0, 3).map((tag) => (
              <span class="text-[11px] font-normal px-2.5 py-0.5 rounded-full bg-transparent border border-[#E6A635]/30 text-amber-100/85">
                {tag}
              </span>
            ))}
            {recipe.tags.length > 3 && (
              <span class="text-[11px] text-amber-200/75 font-mono-recetario self-center px-1">
                +{recipe.tags.length - 3}
              </span>
            )}
          </>
        )}
      </div>
    </div>

    <!-- Card Action Button estilizado -->
    <div class="pt-3 border-t border-[#E6A635]/15 mt-3">
      {isFree ? (
        <button
          type="button"
          data-action="open-recipe"
          data-recipe-id={recipe.id}
          class="w-full py-2.5 px-4 bg-gradient-to-r from-[#E6A635] via-[#F5D061] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] font-bold text-xs sm:text-sm rounded-xl transition-all duration-200 shadow-[0_4px_14px_rgba(230,166,53,0.3)] hover:shadow-[0_6px_20px_rgba(245,208,97,0.45)] active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2 group/btn"
        >
          <span>Ver receta completa</span>
          <svg
            class="w-4 h-4 text-[#28050D] group-hover/btn:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </button>
      ) : (
        <div class="card-vip-action">
          <button
            type="button"
            data-action="open-recipe"
            data-recipe-id={recipe.id}
            class="card-vip-btn w-full py-2.5 px-4 bg-[#1E0308] hover:bg-[#340811] border border-[#E6A635]/35 hover:border-[#F5D061] text-amber-200 hover:text-white font-semibold text-xs rounded-xl transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <svg
              class="w-4 h-4 text-[#F5D061]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
              />
            </svg>
            <span>Desbloquear receta</span>
          </button>
        </div>
      )}
    </div>
  </div>
</article>
