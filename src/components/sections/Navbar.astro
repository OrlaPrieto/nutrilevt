---
import { Image } from "astro:assets";
import logoImg from "../../assets/logo_nutrilev_final_2.png";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
import InstagramIcon from "../ui/icons/InstagramIcon.astro";
import FacebookIcon from "../ui/icons/FacebookIcon.astro";
import LanguagePicker from "../ui/LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langPath = lang === "es" ? "" : `/${lang}`;

// Control de vigencia: Visible hasta el 31 de Diciembre del 2026 (23:59:59)
const holidayBannerExpiry = new Date("2026-12-31T23:59:59");
const isHolidayBannerActive = new Date() <= holidayBannerExpiry;
---

<header class="fixed top-0 left-0 w-full z-50">
  <!-- Top Bar -->
  <div class="bg-primary text-white py-2 px-4 sm:px-6 lg:px-8">
    <div
      class="max-w-7xl mx-auto flex justify-between items-center text-xs sm:text-sm font-medium"
    >
      <div class="hidden sm:block uppercase tracking-wider">
        {
          lang === "es"
            ? "Nutrición Clínica Especializada"
            : "Specialized Clinical Nutrition"
        }
      </div>
      <div class="flex items-center gap-4 ml-auto sm:ml-0">
        <LanguagePicker />
        <div class="h-4 w-[1px] bg-white/20 hidden sm:block"></div>
        <a
          href="https://wa.me/526143958598"
          target="_blank"
          aria-label="WhatsApp"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <WhatsAppIcon class="w-4 h-4" />
          <span class="hidden xs:inline">WhatsApp</span>
        </a>
        <a
          href="https://www.instagram.com/nutrilev_especializada"
          target="_blank"
          aria-label="Instagram"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <InstagramIcon class="w-4 h-4" />
          <span class="hidden xs:inline">Instagram</span>
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=100064033451986"
          target="_blank"
          aria-label="Facebook"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <FacebookIcon class="w-4 h-4" />
          <span class="hidden xs:inline">Facebook</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <nav
    id="main-nav"
    class="bg-white/60 backdrop-blur-xl border-b border-white/20 relative transition-all duration-300"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20 md:h-32">
        <div class="flex-shrink-0">
          <a href={`${langPath}/`} class="block logo-container">
            <Image
              src={logoImg}
              alt="Nutrilev Logo"
              class="logo-img object-contain"
              loading="eager"
              fetchpriority="high"
              width={292}
              height={112}
              quality={50}
            />
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="md:hidden">
          <button
            id="mobile-menu-button"
            class="text-slate-600 hover:text-primary p-2 focus:outline-none transition-colors"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              id="hamburger-icon"
              class="w-8 h-8"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              id="close-icon"
              class="w-8 h-8 hidden"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          <a
            href={`${langPath}/`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.inicio")}</a
          >

          <a
            href={`${langPath}/#services`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.servicios")}</a
          >

          <a
            href={`${langPath}/#consultation-modes`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.modalidades")}</a
          >

          <a
            href={`${langPath}/#app`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.app")}</a
          >

          <a
            href={`${langPath}/#clinical-history`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.historial")}</a
          >

          <a
            href={`${langPath}/#faq`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.faq")}</a
          >

          <a
            href={`${langPath}/blog`}
            data-astro-prefetch="hover"
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.blog")}</a
          >

          <div class="ml-3">
            <a
              href={`${langPath}/#booking`}
              class="relative inline-block bg-primary text-white px-8 py-3 rounded-full text-sm font-bold transition-all shadow-glow hover:shadow-glow-lg hover:scale-110 active:scale-95 animate-gentle-pulse animate-shimmer"
            >
              <span class="relative z-10">{t("nav.agendar")}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Banner Navideño Delgado (Debajo del Header, visible hasta el 31 de Diciembre del 2026) -->
  {isHolidayBannerActive && (
    <aside
      id="holiday-navbar-banner"
      class="holiday-banner-element relative z-40 bg-gradient-to-r from-[#1E0207] via-[#480816] to-[#1E0207] border-y border-[#E6A635]/35 shadow-md no-print overflow-hidden"
      aria-label={lang === "es" ? "Banner Recetario Navideño 2026" : "Holiday Recipe Book 2026 Banner"}
    >
      <a
        href={`${langPath}/recetario`}
        data-astro-prefetch="hover"
        class="group relative block w-full py-1.5 sm:py-2 px-3 sm:px-6 transition-all duration-300 hover:brightness-110"
      >
        <!-- Background subtle Christmas glows & sparkles -->
        <div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#F5D061_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="absolute -top-6 left-1/4 w-32 h-16 bg-[#F5D061]/15 rounded-full blur-xl pointer-events-none"></div>
        <div class="absolute -bottom-6 right-1/4 w-32 h-16 bg-emerald-500/15 rounded-full blur-xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto flex items-center justify-between sm:justify-center gap-2.5 sm:gap-5 relative z-10 text-white text-xs sm:text-sm font-medium">
          
          <!-- Figuras Navideñas Izquierda: Copo de Nieve y Pino SVG en Trazo Fino -->
          <div class="flex items-center gap-1.5 text-[#F5D061] shrink-0">
            <svg class="w-4 h-4 text-[#F5D061] animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="2" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
              <line x1="4.93" y1="19.07" x2="19.07" y2="4.93"></line>
              <path d="M10 4 L12 2 L14 4"></path>
              <path d="M10 20 L12 22 L14 20"></path>
              <path d="M4 10 L2 12 L4 14"></path>
              <path d="M20 10 L22 12 L20 14"></path>
            </svg>
            <svg class="w-3.5 h-3.5 text-[#34D399] hidden sm:block" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L4 12H7L2 19H10V22H14V19H22L17 12H20L12 2Z" opacity="0.9" />
            </svg>
          </div>

          <!-- Contenido Central: Badge Esmeralda + Anuncio Editorial -->
          <div class="flex items-center gap-2 sm:gap-3 truncate">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#157347]/90 border border-[#34D399]/40 text-[#A7F3D0] text-[10px] sm:text-[11px] font-bold uppercase tracking-wider shrink-0 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-[#34D399] animate-pulse"></span>
              <span>{lang === "es" ? "Navidad 2026" : "Holiday 2026"}</span>
            </span>

            <span class="text-amber-100/90 text-xs sm:text-sm font-medium truncate">
              {
                lang === "es" ? (
                  <>
                    <strong class="text-white font-semibold">Recetario Navideño:</strong>{" "}
                    <span class="hidden md:inline text-amber-200/80">185 recetas saludables con respaldo clínico</span>
                  </>
                ) : (
                  <>
                    <strong class="text-white font-semibold">Holiday Recipe Book:</strong>{" "}
                    <span class="hidden md:inline text-amber-200/80">185 clinical-backed healthy recipes</span>
                  </>
                )
              }
            </span>
          </div>

          <!-- Figuras Navideñas Derecha: Botón Dorado CTA y Destello de Estrella -->
          <div class="flex items-center gap-2 shrink-0">
            <span class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1 rounded-full bg-gradient-to-r from-[#E6A635] via-[#F5D061] to-[#D49522] group-hover:from-[#F5D061] group-hover:to-[#E6A635] text-[#28050D] font-extrabold text-[10px] sm:text-xs uppercase tracking-wider shadow-sm transition-all">
              <span>{lang === "es" ? "Ver Recetario" : "View Recipes"}</span>
              <svg class="w-3 h-3 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
              </svg>
            </span>

            <svg class="w-3.5 h-3.5 text-[#F5D061] hidden sm:block animate-pulse" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5L12 0Z"></path>
            </svg>
          </div>

        </div>
      </a>
    </aside>
  )}

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class:list={[
      "fixed inset-0 md:hidden bg-[#FFFFFF] z-50 transform translate-x-full transition-transform duration-300 ease-in-out border-t border-pink-50",
      isHolidayBannerActive ? "top-[152px]" : "top-[120px]"
    ]}
  >
    <div
      class="flex flex-col items-center justify-start h-full pt-12 space-y-8 px-6 text-center"
    >
      <a
        href={`${langPath}/`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.inicio")}</a
      >

      <a
        href={`${langPath}/#services`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.servicios")}</a
      >

      <a
        href={`${langPath}/#consultation-modes`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.modalidades")}</a
      >

      <a
        href={`${langPath}/#app`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.app")}</a
      >

      <a
        href={`${langPath}/#clinical-history`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.historial")}</a
      >

      <a
        href={`${langPath}/#faq`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.faq")}</a
      >

      <a
        href={`${langPath}/blog`}
        data-astro-prefetch="hover"
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.blog")}</a
      >

      <div class="pt-4 w-full max-w-xs">
        <a
          href={`${langPath}/#booking`}
          class="mobile-link block w-full bg-primary text-white py-5 rounded-2xl text-xl font-bold shadow-xl shadow-pink-100 active:scale-95 transition-transform"
        >
          {t("nav.agendar")}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  let scrollListener: (() => void) | null = null;

  function initNavbar() {
    const header = document.querySelector("header");
    if (!header || header.hasAttribute("data-initialized")) return;
    header.setAttribute("data-initialized", "true");

    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    function toggleMenu() {
      const isOpened = !mobileMenu?.classList.contains("translate-x-full");

      if (isOpened) {
        mobileMenu?.classList.add("translate-x-full");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
        mobileMenuButton?.setAttribute("aria-expanded", "false");
      } else {
        mobileMenu?.classList.remove("translate-x-full");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        mobileMenuButton?.setAttribute("aria-expanded", "true");
      }
    }

    mobileMenuButton?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("translate-x-full");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      });
    });

    // Dynamic Navbar on Scroll - Synchronized with Animation Frames
    const mainNav = document.getElementById("main-nav");
    let ticking = false;

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY > 20) {
            mainNav?.classList.add(
              "bg-white/90",
              "backdrop-blur-xl",
              "shadow-md",
              "border-pink-100/50",
            );
            mainNav?.classList.remove(
              "bg-white/40",
              "backdrop-blur-md",
              "border-transparent",
            );
          } else {
            mainNav?.classList.remove(
              "bg-white/90",
              "backdrop-blur-xl",
              "shadow-md",
              "border-pink-100/50",
            );
            mainNav?.classList.add(
              "bg-white/40",
              "backdrop-blur-md",
              "border-transparent",
            );
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    if (scrollListener) {
      window.removeEventListener("scroll", scrollListener);
    }
    scrollListener = handleScroll;
    window.addEventListener("scroll", scrollListener, { passive: true });
    // Initial check
    handleScroll();
  }

  // Defer non-critical initialization to free up the main thread during navigation
  document.addEventListener("astro:page-load", () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => initNavbar());
    } else {
      setTimeout(initNavbar, 1);
    }
  });
</script>

<style>
  @keyframes gentle-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 10px rgba(255, 107, 155, 0.4);
    }
    50% {
      transform: scale(1.08);
      box-shadow: 0 0 25px rgba(216, 27, 96, 0.6);
    }
  }

  @keyframes shimmer-auto {
    0% {
      transform: translateX(-200%) skewX(-25deg);
    }
    20%,
    100% {
      transform: translateX(200%) skewX(-25deg);
    }
  }

  .animate-gentle-pulse {
    animation: gentle-pulse 2s infinite ease-in-out;
  }

  /* Automatic glint/shimmer every 5 seconds */
  .animate-shimmer-auto {
    animation: shimmer-auto 5s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Critical Landing Performance: Explicit LCP Dimensions */
  .logo-container {
    display: block;
    height: 64px; /* Mobile header height equivalent */
    aspect-ratio: 292 / 112;
  }

  .logo-img {
    height: 100%;
    width: auto;
  }

  @media (min-width: 768px) {
    .logo-container {
      height: 96px; /* Desktop height equivalent */
    }
  }

  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 24s linear infinite;
  }
</style>

<script is:inline>
  // Verificación en runtime: ocultar automáticamente el banner al iniciar 2027
  (() => {
    function checkBannerExpiry() {
      const banner = document.getElementById("holiday-navbar-banner");
      if (banner) {
        const expiryTime = new Date("2026-12-31T23:59:59").getTime();
        if (Date.now() > expiryTime) {
          banner.remove();
          const mobileMenu = document.getElementById("mobile-menu");
          if (mobileMenu) {
            mobileMenu.classList.remove("top-[152px]");
            mobileMenu.classList.add("top-[120px]");
          }
        }
      }
    }
    checkBannerExpiry();
    document.addEventListener("astro:page-load", checkBannerExpiry);
  })();
</script>
