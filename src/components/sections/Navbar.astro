---
import { Image } from "astro:assets";
import logoImg from "../../assets/logo_nutrilev_final_2.png";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
import InstagramIcon from "../ui/icons/InstagramIcon.astro";
import FacebookIcon from "../ui/icons/FacebookIcon.astro";
import LanguagePicker from "../ui/LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langPath = lang === "es" ? "" : `/${lang}`;

// Control de vigencia: Visible hasta el 31 de Diciembre del 2026 (23:59:59)
const holidayBannerExpiry = new Date("2026-12-31T23:59:59");
const isHolidayBannerActive = new Date() <= holidayBannerExpiry;

// Solo visible en la página principal (Home en español o inglés)
const rawPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHomePage = rawPathname === "/" || rawPathname === "/en";
const isBannerVisible = isHolidayBannerActive && isHomePage;
---

<header class="fixed top-0 left-0 w-full z-50">
  <!-- Top Bar -->
  <div class="bg-primary text-white py-2 px-4 sm:px-6 lg:px-8">
    <div
      class="max-w-7xl mx-auto flex justify-between items-center text-xs sm:text-sm font-medium"
    >
      <div class="hidden sm:block uppercase tracking-wider">
        {
          lang === "es"
            ? "Nutrición Clínica Especializada"
            : "Specialized Clinical Nutrition"
        }
      </div>
      <div class="flex items-center gap-4 ml-auto sm:ml-0">
        <LanguagePicker />
        <div class="h-4 w-[1px] bg-white/20 hidden sm:block"></div>
        <a
          href="https://wa.me/526143958598"
          target="_blank"
          aria-label="WhatsApp"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <WhatsAppIcon class="w-4 h-4" />
          <span class="hidden xs:inline">WhatsApp</span>
        </a>
        <a
          href="https://www.instagram.com/nutrilev_especializada"
          target="_blank"
          aria-label="Instagram"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <InstagramIcon class="w-4 h-4" />
          <span class="hidden xs:inline">Instagram</span>
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=100064033451986"
          target="_blank"
          aria-label="Facebook"
          class="flex items-center gap-1.5 hover:text-white/80 transition-colors"
        >
          <FacebookIcon class="w-4 h-4" />
          <span class="hidden xs:inline">Facebook</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <nav
    id="main-nav"
    class="bg-white/60 backdrop-blur-xl border-b border-white/20 relative transition-all duration-300"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20 md:h-32">
        <div class="flex-shrink-0">
          <a href={`${langPath}/`} class="block logo-container">
            <Image
              src={logoImg}
              alt="Nutrilev Logo"
              class="logo-img object-contain"
              loading="eager"
              fetchpriority="high"
              width={292}
              height={112}
              quality={50}
            />
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="md:hidden">
          <button
            id="mobile-menu-button"
            class="text-slate-600 hover:text-primary p-2 focus:outline-none transition-colors"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              id="hamburger-icon"
              class="w-8 h-8"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              id="close-icon"
              class="w-8 h-8 hidden"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          <a
            href={`${langPath}/`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.inicio")}</a
          >

          <a
            href={`${langPath}/#services`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.servicios")}</a
          >

          <a
            href={`${langPath}/#consultation-modes`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.modalidades")}</a
          >

          <a
            href={`${langPath}/#app`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.app")}</a
          >

          <a
            href={`${langPath}/#clinical-history`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.historial")}</a
          >

          <a
            href={`${langPath}/#faq`}
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.faq")}</a
          >

          <a
            href={`${langPath}/blog`}
            data-astro-prefetch="hover"
            class="text-slate-600 hover:text-primary px-4 py-2 text-sm font-semibold transition-colors"
            >{t("nav.blog")}</a
          >

          <div class="ml-3">
            <a
              href={`${langPath}/#booking`}
              class="relative inline-block bg-primary text-white px-8 py-3 rounded-full text-sm font-bold transition-all shadow-glow hover:shadow-glow-lg hover:scale-110 active:scale-95 animate-gentle-pulse animate-shimmer"
            >
              <span class="relative z-10">{t("nav.agendar")}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Banner Navideño Promocional Editorial (Solo en la página principal, visible hasta el 31 de Diciembre del 2026) -->
  {isBannerVisible && (
    <aside
      id="holiday-navbar-banner"
      class="holiday-banner-element relative z-40 bg-gradient-to-r from-[#240309] via-[#4A0A16] to-[#240309] border-t border-[#F5D061]/15 border-b border-[#E6A635]/35 no-print overflow-hidden shadow-md"
      aria-label={lang === "es" ? "Banner Recetario Navideño 2026" : "Holiday Recipe Book 2026 Banner"}
    >
      <a
        href={`${langPath}/recetario`}
        data-astro-prefetch="hover"
        class="group relative block w-full h-[76px] sm:h-[86px] md:h-[94px] flex flex-col justify-end pb-3 sm:pb-3.5 md:pb-4 px-4 overflow-hidden transition-all duration-300 hover:brightness-105 focus:outline-none"
      >
        <!-- 1. ILUSTRACIONES LADO IZQUIERDO: Rama de pino realista, Ciervo / Reno majestuoso y polvo de estrellas -->
        <!-- Rama de pino en esquina superior izquierda -->
        <svg class="absolute top-0 left-0 w-48 sm:w-64 md:w-80 h-auto text-[#C9933E] opacity-75 pointer-events-none select-none" viewBox="0 0 260 100" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
          <path d="M-10 -5 C40 15, 110 25, 180 20 M90 20 C130 35, 180 45, 230 40" stroke-width="2.5" stroke="#8C531E"/>
          <g stroke-width="1.2" opacity="0.85">
            <path d="M10 5 L-5 25 M15 7 L5 30 M20 9 L15 35 M25 10 L25 38 M30 11 L35 37 M35 12 L45 35 M40 13 L55 30"/>
            <path d="M50 14 L35 40 M55 16 L45 45 M60 17 L55 50 M65 18 L65 52 M70 19 L75 50 M75 20 L85 45 M80 21 L95 40"/>
            <path d="M90 21 L75 48 M95 22 L85 53 M100 23 L95 58 M105 23 L105 60 M110 24 L115 58 M115 24 L125 53 M120 23 L135 48"/>
            <path d="M130 22 L115 48 M135 22 L125 52 M140 22 L135 55 M145 22 L145 56 M150 21 L155 54 M155 20 L165 48 M160 19 L175 42"/>
            <path d="M170 19 L160 38 M180 18 L175 42 M190 17 L190 44 M200 16 L205 40 M210 15 L220 35"/>
          </g>
        </svg>

        <!-- Silueta de Reno / Ciervo elegante dorado de pie mirando a la derecha -->
        <svg class="absolute bottom-1 sm:bottom-2 left-6 sm:left-14 md:left-24 w-16 sm:w-20 md:w-24 h-auto text-[#D4A047] opacity-85 pointer-events-none select-none drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" viewBox="0 0 100 110" fill="currentColor" aria-hidden="true">
          <!-- Antlers / Cornamenta -->
          <path d="M54 28 C53 22, 50 16, 44 11 C42 9, 39 8, 38 10 C37 11, 39 13, 41 14 C44 16, 46 20, 48 24 M46 18 C43 17, 38 18, 36 21 C35 23, 38 23, 40 22 C43 21, 46 23, 47 26 M55 26 C57 18, 62 10, 68 5 C70 3, 73 3, 73 5 C73 7, 70 9, 68 11 C65 14, 62 19, 60 25 M64 12 C67 11, 72 12, 75 14 C76 15, 74 17, 72 16 C69 15, 66 16, 64 18 M62 19 C66 19, 70 21, 73 24 C74 25, 72 26, 70 25 C67 24, 64 23, 61 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
          <!-- Cuerpo estético del venado -->
          <path d="M53 28 C52 26, 50 25, 48 26 C46 27, 45 29, 44 32 C41 33, 38 35, 36 38 C34 40, 36 41, 38 41 C42 41, 46 39, 48 37 L51 44 C53 49, 56 56, 58 63 C52 64, 45 66, 38 71 C34 74, 30 79, 28 85 C27 88, 29 89, 31 87 C33 85, 36 80, 40 77 C43 75, 47 74, 52 74 L50 88 C49 94, 48 100, 47 106 C47 108, 49 108, 50 106 C52 102, 54 94, 55 88 L58 74 C63 74, 68 75, 72 78 L69 90 C67 96, 66 102, 65 107 C65 109, 67 109, 68 107 C70 103, 72 96, 74 90 L78 77 C81 75, 84 72, 85 68 C86 64, 84 62, 82 63 C80 64, 78 66, 76 68 C74 65, 70 63, 65 63 C63 56, 60 48, 57 41 L59 34 C60 31, 59 29, 57 28 C55 27, 54 28, 53 28 Z"/>
          <path d="M28 72 C25 70, 23 72, 24 75 C25 78, 28 80, 30 77 Z"/>
        </svg>

        <!-- Polvo celestial de estrellas y destellos dorados -->
        <svg class="absolute top-2 left-24 sm:left-40 md:left-56 w-28 sm:w-40 md:w-52 h-20 text-[#F5D061] opacity-75 pointer-events-none select-none" viewBox="0 0 140 70" fill="currentColor" aria-hidden="true">
          <path d="M20 15 L21.5 20 L26 21.5 L21.5 23 L20 28 L18.5 23 L14 21.5 L18.5 20 Z"/>
          <path d="M52 10 L53 13 L56 14 L53 15 L52 18 L51 15 L48 14 L51 13 Z" opacity="0.85"/>
          <path d="M85 22 L86.5 27 L91 28.5 L86.5 30 L85 35 L83.5 30 L79 28.5 L83.5 27 Z"/>
          <path d="M112 12 L113 14 L115 15 L113 16 L112 18 L111 16 L109 15 L111 14 Z" opacity="0.8"/>
          <path d="M38 42 L39 44 L41 45 L39 46 L38 48 L37 46 L35 45 L37 44 Z" opacity="0.7"/>
          <path d="M72 40 L73 42 L75 43 L73 44 L72 46 L71 44 L69 43 L71 42 Z" opacity="0.75"/>
          <circle cx="10" cy="32" r="1.2" opacity="0.7"/>
          <circle cx="34" cy="18" r="1" opacity="0.6"/>
          <circle cx="68" cy="15" r="1.5" opacity="0.8"/>
          <circle cx="98" cy="38" r="1.2" opacity="0.7"/>
          <circle cx="125" cy="28" r="1" opacity="0.6"/>
        </svg>

        <!-- 2. ILUSTRACIONES LADO DERECHO: Pavo navideño en bandeja, esferas, anís, piñas y vajilla festiva -->
        <svg class="absolute top-0 right-0 w-64 sm:w-80 md:w-[420px] h-full text-[#C9933E] opacity-75 pointer-events-none select-none hidden sm:block" viewBox="0 0 340 100" fill="none" stroke="currentColor" aria-hidden="true">
          <!-- Esfera colgante 1 -->
          <line x1="295" y1="0" x2="295" y2="24" stroke-width="1.2" stroke-dasharray="2,2"/>
          <rect x="292.5" y="24" width="5" height="3" fill="#D4A047" rx="0.5"/>
          <circle cx="295" cy="34" r="7" fill="#D4A047" opacity="0.85"/>
          <circle cx="295" cy="34" r="7" stroke-width="1" stroke="#F5D061"/>

          <!-- Esfera colgante 2 -->
          <line x1="318" y1="0" x2="318" y2="42" stroke-width="1" stroke-dasharray="2,2"/>
          <rect x="316" y="42" width="4" height="2.5" fill="#D4A047" rx="0.5"/>
          <circle cx="318" cy="50" r="5.5" fill="#D4A047" opacity="0.85"/>

          <!-- Piña de pino superior -->
          <g transform="translate(245, 2) scale(0.7)" fill="currentColor" stroke-width="0.8">
            <path d="M15 2 C22 2, 26 8, 25 18 C24 26, 18 32, 15 35 C12 32, 6 26, 5 18 C4 8, 8 2, 15 2 Z" opacity="0.3"/>
            <path d="M15 5 C18 8, 21 11, 20 16 M15 11 C20 14, 23 18, 21 24 M15 17 C19 21, 21 25, 18 30 M15 5 C12 8, 9 11, 10 16 M15 11 C10 14, 7 18, 9 24 M15 17 C11 21, 9 25, 12 30" stroke="currentColor"/>
          </g>

          <!-- Pavo Asado Navideño en bandeja ovalada con hierbas aromáticas -->
          <g transform="translate(262, 5) scale(0.9)" stroke-width="1.3">
            <ellipse cx="35" cy="32" rx="32" ry="14" stroke="currentColor" fill="none" opacity="0.45"/>
            <ellipse cx="35" cy="32" rx="28" ry="12" stroke="currentColor" fill="#2E050D" opacity="0.8"/>
            <path d="M18 30 C16 22, 22 14, 32 14 C42 14, 50 20, 52 28 C52 34, 46 38, 35 38 C24 38, 18 36, 18 30 Z" fill="#D4A047" opacity="0.85"/>
            <path d="M42 22 C46 18, 52 18, 54 22 C55 25, 52 29, 48 30 M52 20 L58 16 C59 15, 61 16, 60 17 L55 23" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M26 22 C22 18, 16 18, 14 22 C13 25, 16 29, 20 30 M16 20 L10 16 C9 15, 7 16, 8 17 L13 23" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M12 34 Q8 32, 10 28 M18 40 Q15 42, 12 38 M52 38 Q56 42, 60 38 M58 32 Q62 30, 60 26" stroke="#C9933E" stroke-width="1.2"/>
          </g>

          <!-- Estrella de anís gastronómica -->
          <g transform="translate(258, 56) scale(0.8)" fill="currentColor">
            <path d="M15 4 L17 11 L23 8 L20 14 L26 17 L19 20 L21 26 L15 22 L9 26 L11 20 L4 17 L10 14 L7 8 L13 11 Z" opacity="0.75"/>
            <circle cx="15" cy="15" r="2.5" fill="#2E050D"/>
            <circle cx="15" cy="15" r="1.2" fill="#F5D061"/>
          </g>

          <!-- Plato festivo con cuchillo, tenedor y hojas de acebo -->
          <g transform="translate(290, 50) scale(0.95)" stroke-width="1.3">
            <circle cx="28" cy="28" r="24" stroke="currentColor" opacity="0.45"/>
            <circle cx="28" cy="28" r="18" stroke="currentColor" opacity="0.3"/>
            <path d="M24 22 C21 24, 21 28, 25 30 C27 26, 29 25, 28 22 Z" fill="#D4A047" opacity="0.7"/>
            <path d="M32 24 C35 26, 34 30, 30 31 C29 27, 28 26, 30 23 Z" fill="#D4A047" opacity="0.7"/>
            <circle cx="28" cy="27" r="1.5" fill="#F5D061"/>
            <path d="M48 10 L48 42 M48 10 C48 10, 45 15, 45 26 L48 28" stroke="currentColor" stroke-width="1.2"/>
            <path d="M8 24 L8 44 M8 24 C8 20, 5 20, 5 12 M8 20 L8 12 M8 20 C8 20, 11 20, 11 12" stroke="currentColor" stroke-width="1.2"/>
          </g>

          <!-- Piña de pino inferior -->
          <g transform="translate(275, 80) scale(0.65)" fill="currentColor" stroke-width="0.8">
            <path d="M15 2 C22 2, 26 8, 25 18 C24 26, 18 32, 15 35 C12 32, 6 26, 5 18 C4 8, 8 2, 15 2 Z" opacity="0.3"/>
            <path d="M15 5 C18 8, 21 11, 20 16 M15 11 C20 14, 23 18, 21 24 M15 5 C12 8, 9 11, 10 16 M15 11 C10 14, 7 18, 9 24" stroke="currentColor"/>
          </g>

          <!-- Destellos dorados festivos -->
          <path d="M252 42 L253 44 L255 45 L253 46 L252 48 L251 46 L249 45 L251 44 Z" fill="#F5D061" opacity="0.8"/>
          <path d="M285 16 L286 18 L288 19 L286 20 L285 22 L284 20 L282 19 L284 18 Z" fill="#F5D061" opacity="0.8"/>
          <circle cx="238" cy="52" r="1.2" fill="#F5D061" opacity="0.7"/>
          <circle cx="268" cy="38" r="1.2" fill="#F5D061" opacity="0.7"/>
        </svg>

        <!-- 3. CONTENIDO PRINCIPAL CENTRADO Y LIMPIO (PARTE INFERIOR) -->
        <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm text-center relative z-10">
          <!-- Prefijo solo en escritorio -->
          <span class="hidden md:inline text-[#E6A635] text-[11px] font-bold uppercase tracking-[0.2em] shrink-0">
            {lang === "es" ? "EDICIÓN 2026" : "2026 EDITION"}
          </span>

          <span class="text-white/20 hidden md:inline select-none" aria-hidden="true">·</span>

          <!-- Texto principal con gancho comercial -->
          <span class="text-amber-50 font-medium truncate sm:overflow-visible">
            {lang === "es" ? "185 recetas navideñas · Prueba 6 gratis" : "185 holiday recipes · Try 6 for free"}
          </span>

          <!-- Botón Outline Fino y Elegante con Flecha -->
          <span class="ml-1 sm:ml-2.5 px-3 sm:px-3.5 py-0.5 rounded-full border border-[#E6A635]/80 bg-[#E6A635]/10 text-[#F5D061] group-hover:bg-[#F5D061] group-hover:text-[#28050D] text-[11px] sm:text-xs font-semibold transition-all whitespace-nowrap inline-flex items-center gap-1 shrink-0 shadow-sm">
            <span>{lang === "es" ? "Ver recetario" : "View recipes"}</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
          </span>
        </div>
      </a>
    </aside>
  )}

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class:list={[
      "fixed inset-0 md:hidden bg-[#FFFFFF] z-50 transform translate-x-full transition-transform duration-300 ease-in-out border-t border-pink-50",
      isBannerVisible ? "top-[192px]" : "top-[120px]"
    ]}
  >
    <div
      class="flex flex-col items-center justify-start h-full pt-12 space-y-8 px-6 text-center"
    >
      <a
        href={`${langPath}/`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.inicio")}</a
      >

      <a
        href={`${langPath}/#services`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.servicios")}</a
      >

      <a
        href={`${langPath}/#consultation-modes`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.modalidades")}</a
      >

      <a
        href={`${langPath}/#app`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.app")}</a
      >

      <a
        href={`${langPath}/#clinical-history`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.historial")}</a
      >

      <a
        href={`${langPath}/#faq`}
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.faq")}</a
      >

      <a
        href={`${langPath}/blog`}
        data-astro-prefetch="hover"
        class="mobile-link text-2xl font-bold text-slate-800 hover:text-primary transition-colors"
        >{t("nav.blog")}</a
      >

      <div class="pt-4 w-full max-w-xs">
        <a
          href={`${langPath}/#booking`}
          class="mobile-link block w-full bg-primary text-white py-5 rounded-2xl text-xl font-bold shadow-xl shadow-pink-100 active:scale-95 transition-transform"
        >
          {t("nav.agendar")}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  let scrollListener: (() => void) | null = null;

  function initNavbar() {
    const header = document.querySelector("header");
    if (!header || header.hasAttribute("data-initialized")) return;
    header.setAttribute("data-initialized", "true");

    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    function toggleMenu() {
      const isOpened = !mobileMenu?.classList.contains("translate-x-full");

      if (isOpened) {
        mobileMenu?.classList.add("translate-x-full");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
        mobileMenuButton?.setAttribute("aria-expanded", "false");
      } else {
        mobileMenu?.classList.remove("translate-x-full");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        mobileMenuButton?.setAttribute("aria-expanded", "true");
      }
    }

    mobileMenuButton?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("translate-x-full");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      });
    });

    // Dynamic Navbar on Scroll - Synchronized with Animation Frames
    const mainNav = document.getElementById("main-nav");
    let ticking = false;

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY > 20) {
            mainNav?.classList.add(
              "bg-white/90",
              "backdrop-blur-xl",
              "shadow-md",
              "border-pink-100/50",
            );
            mainNav?.classList.remove(
              "bg-white/40",
              "backdrop-blur-md",
              "border-transparent",
            );
          } else {
            mainNav?.classList.remove(
              "bg-white/90",
              "backdrop-blur-xl",
              "shadow-md",
              "border-pink-100/50",
            );
            mainNav?.classList.add(
              "bg-white/40",
              "backdrop-blur-md",
              "border-transparent",
            );
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    if (scrollListener) {
      window.removeEventListener("scroll", scrollListener);
    }
    scrollListener = handleScroll;
    window.addEventListener("scroll", scrollListener, { passive: true });
    // Initial check
    handleScroll();
  }

  // Defer non-critical initialization to free up the main thread during navigation
  document.addEventListener("astro:page-load", () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => initNavbar());
    } else {
      setTimeout(initNavbar, 1);
    }
  });
</script>

<style>
  @keyframes gentle-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 10px rgba(255, 107, 155, 0.4);
    }
    50% {
      transform: scale(1.08);
      box-shadow: 0 0 25px rgba(216, 27, 96, 0.6);
    }
  }

  @keyframes shimmer-auto {
    0% {
      transform: translateX(-200%) skewX(-25deg);
    }
    20%,
    100% {
      transform: translateX(200%) skewX(-25deg);
    }
  }

  .animate-gentle-pulse {
    animation: gentle-pulse 2s infinite ease-in-out;
  }

  /* Automatic glint/shimmer every 5 seconds */
  .animate-shimmer-auto {
    animation: shimmer-auto 5s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Critical Landing Performance: Explicit LCP Dimensions */
  .logo-container {
    display: block;
    height: 64px; /* Mobile header height equivalent */
    aspect-ratio: 292 / 112;
  }

  .logo-img {
    height: 100%;
    width: auto;
  }

  @media (min-width: 768px) {
    .logo-container {
      height: 96px; /* Desktop height equivalent */
    }
  }
</style>

<script is:inline>
  // Verificación en runtime: ocultar automáticamente el banner al iniciar 2027
  (() => {
    function checkBannerExpiry() {
      const banner = document.getElementById("holiday-navbar-banner");
      if (banner) {
        const expiryTime = new Date("2026-12-31T23:59:59").getTime();
        if (Date.now() > expiryTime) {
          banner.remove();
          const mobileMenu = document.getElementById("mobile-menu");
          if (mobileMenu) {
            mobileMenu.classList.remove("top-[192px]");
            mobileMenu.classList.add("top-[120px]");
          }
        }
      }
    }
    checkBannerExpiry();
    document.addEventListener("astro:page-load", checkBannerExpiry);
  })();
</script>
