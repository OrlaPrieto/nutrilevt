---
import RecetarioLayout from "../../layouts/RecetarioLayout.astro";
import recipesData from "../../data/recipes.json";

// Free preview sample recipe IDs (one per major chapter)
const FREE_SAMPLE_IDS = [
  "001-champurrado-ligero",
  "043-ensalada-campera",
  "085-lomo-de-cerdo-con-champinones",
  "125-pure-de-camote-con-canela",
  "151-trufas-de-datil-y-cacao",
  "176-mousse-de-aguacate-y-cacao"
];

const totalRecipes = recipesData.length;
const categoryCounts = recipesData.reduce((acc, r) => {
  acc[r.categorySlug] = (acc[r.categorySlug] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = [
  { name: "Todas", slug: "todas", count: totalRecipes, color: "bg-slate-900 text-white border-slate-900" },
  { name: "Bebidas", slug: "bebidas", count: categoryCounts["bebidas"] || 0, badge: "bg-rose-100 text-rose-900 border-rose-300" },
  { name: "Ensaladas", slug: "ensaladas", count: categoryCounts["ensaladas"] || 0, badge: "bg-emerald-100 text-emerald-900 border-emerald-300" },
  { name: "Platos Fuertes", slug: "platos-fuertes", count: categoryCounts["platos-fuertes"] || 0, badge: "bg-red-100 text-red-900 border-red-300" },
  { name: "Guarniciones", slug: "guarniciones", count: categoryCounts["guarniciones"] || 0, badge: "bg-amber-100 text-amber-900 border-amber-300" },
  { name: "Postres", slug: "postres", count: categoryCounts["postres"] || 0, badge: "bg-pink-100 text-pink-900 border-pink-300" },
  { name: "Diabetes", slug: "diabetes", count: categoryCounts["diabetes"] || 0, badge: "bg-teal-100 text-teal-900 border-teal-300" },
];

function getCategoryColor(slug: string) {
  switch (slug) {
    case "bebidas":
      return "bg-rose-50 text-rose-800 border-rose-200";
    case "ensaladas":
      return "bg-emerald-50 text-emerald-800 border-emerald-200";
    case "platos-fuertes":
      return "bg-red-50 text-red-900 border-red-200";
    case "guarniciones":
      return "bg-amber-50 text-amber-900 border-amber-200";
    case "postres":
      return "bg-pink-50 text-pink-900 border-pink-200";
    case "diabetes":
      return "bg-teal-50 text-teal-900 border-teal-200";
    default:
      return "bg-slate-50 text-slate-800 border-slate-200";
  }
}
---

<RecetarioLayout
  title="Recetario Navideño 2026 · Edición Clínica VIP | Nutrilev"
  description="185 recetas decembrinas con fotografías reales, equivalentes SMAE, cálculo nutricional exacto y opciones aptas para diabetes por la Nutrióloga Velvet De la Cruz."
>
  <!-- TOP MASTHEAD FESTIVO -->
  <header class="border-b border-[#E8E2D5] bg-[#FDFBF7] sticky top-0 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 sm:gap-6">
        <a
          href="/"
          class="font-sans-recetario text-xs sm:text-sm font-semibold tracking-wide text-slate-800 hover:text-[#881337] transition-colors flex items-center gap-2"
        >
          <span class="text-base">←</span>
          <span>NUTRILEV.COM</span>
        </a>
        <span class="text-[#D8D2C5] hidden sm:inline">|</span>
        <div class="flex items-center gap-2 hidden sm:flex">
          <span class="w-2 h-2 rounded-full bg-[#881337] animate-pulse"></span>
          <span class="font-sans-recetario text-xs font-bold text-[#881337] uppercase tracking-wider">
            RECETARIO NAVIDEÑO 2026
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- VIP Status Pill -->
        <div
          id="vip-status-pill"
          class="font-sans-recetario text-xs font-semibold px-3 py-1.5 border border-[#E8E2D5] bg-white text-slate-700 rounded-lg flex items-center gap-2 shadow-xs"
        >
          <span id="vip-status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
          <span id="vip-status-text">Acceso Restringido</span>
        </div>

        <!-- Unlock / Lock Action Button -->
        <button
          id="btn-vip-toggle"
          type="button"
          class="font-sans-recetario text-xs font-bold uppercase tracking-wider px-4 py-2 bg-[#881337] hover:bg-[#6e1026] text-white rounded-lg transition-all cursor-pointer shadow-sm hover:shadow active:scale-95"
        >
          <span id="btn-vip-text">Ingresar Código</span>
        </button>
      </div>
    </div>
  </header>

  <!-- HERO FESTIVO CON COLOR Y CALIDEZ -->
  <section class="relative bg-gradient-to-b from-[#FFFDF9] via-[#FDF7EE] to-[#FAF3E6] border-b border-[#E8E2D5] overflow-hidden">
    <!-- Ambient Christmas botanical decorative glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-red-100/60 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-100/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Hero Headline -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-rose-100/80 border border-rose-200 text-[#881337] rounded-full text-xs font-bold uppercase tracking-wider mb-4">
            <span>🎄</span>
            <span>Edición Navideña Clínica Exclusiva</span>
            <span class="w-1 h-1 rounded-full bg-[#881337]"></span>
            <span>716 Páginas</span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl lg:text-5xl text-[#2B0E14] leading-[1.15] font-bold tracking-tight mb-5">
            El arte de celebrar con bienestar: 185 recetas navideñas con respaldo clínico.
          </h1>

          <p class="font-sans-recetario text-base sm:text-lg text-slate-700 leading-relaxed mb-6 font-normal">
            Elaborado por la <strong class="text-[#881337] font-semibold">Nutrióloga Velvet De la Cruz Villegas</strong> (Céd. Prof. 10622381) para disfrutar las celebraciones decembrinas sin culpa, con porciones equilibradas, conteo de equivalentes del <strong>SMAE</strong> y alternativas seguras para personas con diabetes.
          </p>

          <!-- Metrics Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl">
            <div class="bg-white/90 backdrop-blur-xs border border-[#E8E2D5] p-3.5 rounded-xl shadow-xs">
              <span class="block font-sans-recetario text-[11px] font-bold text-slate-500 uppercase">Recetas</span>
              <span class="font-display text-2xl sm:text-3xl font-bold text-[#881337]">185</span>
            </div>
            <div class="bg-white/90 backdrop-blur-xs border border-[#E8E2D5] p-3.5 rounded-xl shadow-xs">
              <span class="block font-sans-recetario text-[11px] font-bold text-slate-500 uppercase">Secciones</span>
              <span class="font-display text-2xl sm:text-3xl font-bold text-emerald-800">06</span>
            </div>
            <div class="bg-white/90 backdrop-blur-xs border border-[#E8E2D5] p-3.5 rounded-xl shadow-xs">
              <span class="block font-sans-recetario text-[11px] font-bold text-slate-500 uppercase">Diabetes</span>
              <span class="font-display text-2xl sm:text-3xl font-bold text-teal-700">10</span>
            </div>
            <div class="bg-white/90 backdrop-blur-xs border border-[#E8E2D5] p-3.5 rounded-xl shadow-xs">
              <span class="block font-sans-recetario text-[11px] font-bold text-slate-500 uppercase">Sistema</span>
              <span class="font-display text-2xl sm:text-3xl font-bold text-amber-700">SMAE</span>
            </div>
          </div>
        </div>

        <!-- Right: VIP Commercial Card -->
        <div class="lg:col-span-5 bg-white border border-[#E2D9C8] rounded-2xl p-6 sm:p-8 shadow-sm relative">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#F0EAE0]">
            <span class="font-sans-recetario text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-1.5">
              <span>⭐</span>
              <span>Acceso al Recetario Completo</span>
            </span>
            <span class="text-[11px] font-bold px-2.5 py-0.5 bg-[#881337] text-white rounded-full">
              Edición 2026
            </span>
          </div>

          <div id="hero-vip-locked">
            <h2 class="font-display text-2xl text-[#2B0E14] font-bold mb-2">
              Desbloquea las 185 Recetas
            </h2>
            <p class="font-sans-recetario text-sm text-slate-600 leading-relaxed mb-6">
              Tienes <strong>6 recetas de muestra gratuitas</strong> desbloqueadas para que pruebes el recetario. Para tener acceso ilimitado a las 185 recetas completas con fotografías, porciones e información nutricional, ingresa tu código de acceso o adquiérelo por WhatsApp.
            </p>

            <div class="space-y-3">
              <button
                type="button"
                id="btn-hero-unlock"
                class="w-full py-3.5 px-4 bg-[#881337] hover:bg-[#6e1026] text-white font-sans-recetario font-bold text-sm rounded-xl transition-all shadow-sm hover:shadow cursor-pointer flex items-center justify-center gap-2 active:scale-98"
              >
                <span>🔑</span>
                <span>Ingresar Código de Acceso</span>
              </button>

              <a
                href="https://wa.me/526143958598?text=Hola%20Nutri%C3%B3loga%20Velvet,%20me%20interesa%20adquirir%20el%20Recetario%20Navide%C3%B1o%202026%20completo%20(185%20recetas)."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3.5 px-4 bg-emerald-700 hover:bg-emerald-800 text-white font-sans-recetario font-bold text-sm rounded-xl transition-all shadow-sm hover:shadow text-center flex items-center justify-center gap-2 active:scale-98"
              >
                <span>💬</span>
                <span>Comprar Acceso por WhatsApp</span>
              </a>
            </div>
          </div>

          <div id="hero-vip-unlocked" class="hidden">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-md font-sans-recetario text-xs font-bold mb-2">
              <span>✓</span>
              <span>SESIÓN VIP AUTORIZADA</span>
            </div>
            <h2 class="font-display text-2xl text-[#2B0E14] font-bold mb-2">
              ¡Bienvenido a tu Recetario Completo!
            </h2>
            <p class="font-sans-recetario text-sm text-slate-600 mb-5">
              Tienes acceso ilimitado a las 185 recetas con fotografías en alta definición, tablas de equivalentes clínicos del SMAE y buscador interactivo.
            </p>
            <div class="p-3.5 bg-[#FAF7F2] border border-[#E8E2D5] rounded-xl font-sans-recetario text-sm font-semibold text-slate-800 flex items-center justify-between">
              <span>ESTADO DE CUENTA:</span>
              <span class="text-emerald-700 font-bold">185 RECETAS ACTIVAS</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- CONTROLS & FILTER BAR -->
  <section class="border-b border-[#E8E2D5] bg-[#FDFBF7] sticky top-16 sm:top-20 z-20 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      
      <!-- Top Row: Search and Quick Filters -->
      <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3 mb-3">
        <!-- Search input -->
        <div class="relative flex-1">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base">🔍</span>
          <input
            id="recipe-search"
            type="search"
            placeholder="Buscar receta, ingrediente (pavo, lomo, ponche, avena, chocolate)..."
            class="w-full h-11 pl-10 pr-12 bg-white border border-[#D8D2C5] text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#881337] focus:ring-1 focus:ring-[#881337] rounded-xl font-sans-recetario transition-colors"
          />
          <button
            id="clear-search-btn"
            type="button"
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 font-sans-recetario text-xs font-bold text-slate-400 hover:text-slate-700 px-1.5 py-0.5 rounded cursor-pointer"
          >
            ✕
          </button>
        </div>

        <!-- Quick Tag Filters -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 scrollbar-none">
          <button
            type="button"
            data-filter-tag="Sin azúcar añadida"
            class="filter-tag-btn font-sans-recetario text-xs font-semibold px-3 py-2 bg-white border border-[#D8D2C5] hover:border-slate-800 text-slate-700 rounded-lg whitespace-nowrap cursor-pointer transition-colors"
          >
            Sin azúcar
          </button>
          <button
            type="button"
            data-filter-tag="Baja en grasa"
            class="filter-tag-btn font-sans-recetario text-xs font-semibold px-3 py-2 bg-white border border-[#D8D2C5] hover:border-slate-800 text-slate-700 rounded-lg whitespace-nowrap cursor-pointer transition-colors"
          >
            Baja en grasa
          </button>
          <button
            type="button"
            data-filter-tag="Rica en proteína"
            class="filter-tag-btn font-sans-recetario text-xs font-semibold px-3 py-2 bg-white border border-[#D8D2C5] hover:border-slate-800 text-slate-700 rounded-lg whitespace-nowrap cursor-pointer transition-colors"
          >
            Con proteína
          </button>
          <button
            type="button"
            data-filter-free="true"
            id="filter-free-btn"
            class="font-sans-recetario text-xs font-bold px-3 py-2 bg-emerald-50 border border-emerald-300 hover:bg-emerald-600 hover:text-white text-emerald-800 rounded-lg whitespace-nowrap cursor-pointer transition-colors"
          >
            ★ Muestras Gratis [6]
          </button>
        </div>
      </div>

      <!-- Bottom Row: Category Tabs -->
      <div class="flex items-center justify-between gap-4 overflow-x-auto scrollbar-none pt-1">
        <div class="flex items-center gap-2 flex-nowrap">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat.slug}
              class={`cat-tab-btn font-sans-recetario text-xs font-bold px-3.5 py-1.5 rounded-lg whitespace-nowrap transition-all cursor-pointer border ${
                idx === 0
                  ? "bg-[#881337] text-white border-[#881337] shadow-xs"
                  : "bg-white text-slate-700 border-[#D8D2C5] hover:border-[#881337] hover:text-[#881337]"
              }`}
            >
              <span>{cat.name}</span>
              <span class="opacity-75 ml-1 text-[11px] font-mono-recetario">({cat.count})</span>
            </button>
          ))}
        </div>

        <div class="hidden lg:block font-sans-recetario text-xs text-slate-500 whitespace-nowrap">
          Recetas visibles: <span id="count-visible" class="text-slate-900 font-bold font-mono-recetario">185</span> / 185
        </div>
      </div>

    </div>
  </section>

  <!-- RECIPES CATALOG GRID CON FOTOGRAFÍAS REALES -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Active filters indication -->
    <div id="filter-feedback" class="hidden mb-6 p-3 bg-white border border-[#E8E2D5] rounded-xl flex items-center justify-between font-sans-recetario text-xs font-semibold text-slate-800 shadow-xs">
      <span id="filter-feedback-text">Filtro activo</span>
      <button id="reset-all-filters" type="button" class="text-[#881337] hover:underline cursor-pointer font-bold">
        Limpiar Filtros ✕
      </button>
    </div>

    <!-- Empty Results State -->
    <div id="empty-state" class="hidden text-left py-16 px-8 bg-white border border-[#E8E2D5] rounded-2xl shadow-xs">
      <div class="font-sans-recetario text-xs font-bold uppercase tracking-wider text-[#881337] mb-2">[0 RESULTADOS]</div>
      <h2 class="font-display text-3xl text-slate-900 mb-3 font-bold">No encontramos recetas con ese criterio</h2>
      <p class="font-sans-recetario text-sm text-slate-600 max-w-md mb-6 leading-relaxed">
        Prueba buscando con palabras como "lomo", "pavo", "chocolate", "manzana" o selecciona la categoría "Todas".
      </p>
      <button
        id="btn-reset-empty"
        type="button"
        class="font-sans-recetario text-xs font-bold uppercase tracking-wider px-5 py-2.5 bg-[#881337] text-white rounded-lg cursor-pointer hover:bg-[#6e1026] transition-colors"
      >
        Restaurar Catálogo Completo
      </button>
    </div>

    <!-- The 185 Recipes Grid -->
    <div id="recipes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
      {recipesData.map((recipe) => {
        const isFree = FREE_SAMPLE_IDS.includes(recipe.id);
        const categoryStyle = getCategoryColor(recipe.categorySlug);

        return (
          <article
            data-id={recipe.id}
            data-category={recipe.categorySlug}
            data-calories={recipe.calories}
            data-tags={recipe.tags.join("|")}
            data-title={recipe.title.toLowerCase()}
            data-ingredients={recipe.ingredients.join(" ").toLowerCase()}
            data-free={isFree ? "true" : "false"}
            class="recipe-card bg-white border border-[#E8E2D5] rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:border-[#881337]/50 group"
          >
            <!-- Top: Dish Photo -->
            <div class="relative w-full h-52 bg-slate-100 overflow-hidden cursor-pointer" data-action="open-recipe" data-recipe-id={recipe.id}>
              {recipe.image ? (
                <img
                  src={recipe.image}
                  alt={recipe.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-[#FAF7F2] text-slate-400 font-sans-recetario text-xs">
                  Fotografía de platillo
                </div>
              )}

              <!-- Badges over image -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                <span class={`font-sans-recetario text-[11px] font-bold px-2.5 py-0.5 rounded-full border shadow-xs ${categoryStyle}`}>
                  {recipe.category}
                </span>
                {isFree && (
                  <span class="font-sans-recetario text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-600 text-white shadow-xs">
                    ★ Muestra Libre
                  </span>
                )}
              </div>

              <div class="absolute top-3 right-3">
                <span class="font-mono-recetario text-[11px] font-semibold px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-white">
                  P. {String(recipe.pdfPage).padStart(3, '0')}
                </span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <!-- Title -->
                <h3
                  data-action="open-recipe"
                  data-recipe-id={recipe.id}
                  class="font-display text-xl sm:text-2xl text-slate-900 font-bold leading-snug tracking-tight mb-3 cursor-pointer group-hover:text-[#881337] transition-colors"
                >
                  {recipe.title}
                </h3>

                <!-- Metrics Strip -->
                <div class="grid grid-cols-3 gap-2 py-2.5 px-3 mb-3.5 bg-[#FAF7F2] rounded-xl border border-[#EDE8DF] text-center font-sans-recetario">
                  <div>
                    <span class="block text-[10px] font-bold uppercase text-slate-500">Calorías</span>
                    <span class="text-xs sm:text-sm font-bold text-[#881337] font-mono-recetario">
                      {recipe.calories ? `${recipe.calories} kcal` : "N/D"}
                    </span>
                  </div>
                  <div>
                    <span class="block text-[10px] font-bold uppercase text-slate-500">Tiempo</span>
                    <span class="text-xs sm:text-sm font-semibold text-slate-800">
                      {recipe.prepTime}
                    </span>
                  </div>
                  <div>
                    <span class="block text-[10px] font-bold uppercase text-slate-500">Porción</span>
                    <span class="text-xs sm:text-sm font-semibold text-slate-800 truncate block">
                      {recipe.portions}
                    </span>
                  </div>
                </div>

                <!-- Health Tags -->
                {recipe.tags && recipe.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-3.5">
                    {recipe.tags.slice(0, 3).map((tag) => (
                      <span class="font-sans-recetario text-[11px] font-medium px-2 py-0.5 bg-slate-50 border border-slate-200 text-slate-600 rounded-md">
                        {tag}
                      </span>
                    ))}
                    {recipe.tags.length > 3 && (
                      <span class="font-sans-recetario text-[11px] text-slate-400 self-center">
                        +{recipe.tags.length - 3}
                      </span>
                    )}
                  </div>
                )}

                <!-- Ingredients Preview Teaser -->
                <div class="mb-4">
                  <span class="font-sans-recetario text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1">
                    Ingredientes clave:
                  </span>
                  <ul class="font-sans-recetario text-xs text-slate-600 space-y-1">
                    {recipe.ingredients.slice(0, 2).map((ing) => (
                      <li class="truncate flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 bg-[#881337] rounded-full inline-block shrink-0"></span>
                        <span class="truncate">{ing}</span>
                      </li>
                    ))}
                    {recipe.ingredients.length > 2 && (
                      <li class="text-[11px] text-slate-400 italic">
                        ... y {recipe.ingredients.length - 2} ingredientes más
                      </li>
                    )}
                  </ul>
                </div>
              </div>

              <!-- Card Action Button -->
              <div class="pt-3 border-t border-[#F0EAE0]">
                {isFree ? (
                  <button
                    type="button"
                    data-action="open-recipe"
                    data-recipe-id={recipe.id}
                    class="w-full py-2.5 px-4 bg-[#881337] hover:bg-[#6e1026] text-white font-sans-recetario font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer flex items-center justify-center gap-2 shadow-xs hover:shadow active:scale-98"
                  >
                    <span>Ver Receta Completa</span>
                    <span>→</span>
                  </button>
                ) : (
                  <div class="card-vip-action">
                    <button
                      type="button"
                      data-action="open-recipe"
                      data-recipe-id={recipe.id}
