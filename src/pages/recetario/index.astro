  <!-- EMBEDDED DATA & CLIENT SCRIPT -->
  <script is:inline define:vars={{ recipesData, FREE_SAMPLE_IDS }}>
    // Valid passcodes for instant VIP access
    const VALID_CODES = [
      "NAVIDAD2026",
      "NUTRILEV2026",
      "VELVET2026",
      "RECETARIO2026",
      "VIP2026"
    ];

    const STORAGE_KEY = "nutrilev_recetario_vip_active";

    // Application state
    let isVip = false;
    let activeCategory = "todas";
    let activeTag = null;
    let onlyFree = false;
    let searchQuery = "";

    function checkAuth() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "true") {
          isVip = true;
        }
      } catch (e) {}
      updateAuthUI();
    }

    function setAuth(status) {
      isVip = status;
      try {
        if (status) {
          localStorage.setItem(STORAGE_KEY, "true");
        } else {
          localStorage.removeItem(STORAGE_KEY);
        }
      } catch (e) {}
      updateAuthUI();
      applyFilters();
    }

    function updateAuthUI() {
      const pill = document.getElementById("vip-status-pill");
      const dot = document.getElementById("vip-status-dot");
      const text = document.getElementById("vip-status-text");
      const btn = document.getElementById("btn-vip-toggle");
      const btnText = document.getElementById("btn-vip-text");
      const heroLocked = document.getElementById("hero-vip-locked");
      const heroUnlocked = document.getElementById("hero-vip-unlocked");

      if (isVip) {
        if (dot) dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
        if (text) text.textContent = "Acceso VIP Activo";
        if (btnText) btnText.textContent = "Cerrar Sesión";
        if (btn) btn.className = "font-sans-recetario text-xs font-bold uppercase tracking-wider px-3.5 py-2 bg-white border border-[#D8D2C5] text-slate-700 hover:bg-slate-50 rounded-lg transition-all cursor-pointer";
        if (heroLocked) heroLocked.classList.add("hidden");
        if (heroUnlocked) heroUnlocked.classList.remove("hidden");
      } else {
        if (dot) dot.className = "w-2.5 h-2.5 rounded-full bg-slate-400";
        if (text) text.textContent = "Acceso Restringido";
        if (btnText) btnText.textContent = "Ingresar Código";
        if (btn) btn.className = "font-sans-recetario text-xs font-bold uppercase tracking-wider px-4 py-2 bg-[#881337] hover:bg-[#6e1026] text-white rounded-lg transition-all cursor-pointer shadow-sm hover:shadow";
        if (heroLocked) heroLocked.classList.remove("hidden");
        if (heroUnlocked) heroUnlocked.classList.add("hidden");
      }

      // Update card buttons
      const cardVipButtons = document.querySelectorAll(".card-vip-action");
      cardVipButtons.forEach((div) => {
        const btnAction = div.querySelector(".card-vip-btn");
        if (isVip) {
          if (btnAction) {
            btnAction.innerHTML = "<span>Ver Receta Completa</span> <span>→</span>";
            btnAction.classList.remove("bg-white", "text-slate-800", "border-[#D8D2C5]");
            btnAction.classList.add("bg-[#881337]", "text-white", "border-[#881337]");
          }
        } else {
          if (btnAction) {
            btnAction.innerHTML = "<span>🔒 Desbloquear Receta</span> <span>→</span>";
            btnAction.classList.remove("bg-[#881337]", "text-white", "border-[#881337]");
            btnAction.classList.add("bg-white", "text-slate-800", "border-[#D8D2C5]");
          }
        }
      });
    }

    // Modal logic
    const recipeModal = document.getElementById("recipe-modal");
    const unlockModal = document.getElementById("unlock-modal");

    function openRecipeModal(recipeId) {
      const recipe = recipesData.find((r) => r.id === recipeId);
      if (!recipe) return;

      const isFree = FREE_SAMPLE_IDS.includes(recipeId);
      if (!isFree && !isVip) {
        openUnlockModal();
        return;
      }

      // Populate modal
      const modalImg = document.getElementById("modal-image");
      if (modalImg) {
        modalImg.src = recipe.image || "/images/recetas/001-champurrado-ligero.webp";
        modalImg.alt = recipe.title;
      }

      const modalCat = document.getElementById("modal-category");
      modalCat.textContent = recipe.category;
      modalCat.className = "font-sans-recetario text-xs font-bold uppercase px-2.5 py-0.5 rounded-full border bg-rose-50 text-rose-800 border-rose-200";

      document.getElementById("modal-page").textContent = "Diapositiva " + String(recipe.pdfPage).padStart(3, '0');
      document.getElementById("modal-title").textContent = recipe.title;
      document.getElementById("modal-calories").textContent = (recipe.calories || "N/D") + " kcal";
      document.getElementById("modal-time").textContent = recipe.prepTime;
      document.getElementById("modal-portions").textContent = recipe.portions;

      // Nutrition
      document.getElementById("modal-prot").textContent = recipe.nutrition.protein || "N/D";
      document.getElementById("modal-fat").textContent = recipe.nutrition.fats || "N/D";
      document.getElementById("modal-carb").textContent = recipe.nutrition.carbs || "N/D";
      document.getElementById("modal-fib").textContent = recipe.nutrition.fiber || "N/D";

      // Equivalents
      const eqSec = document.getElementById("modal-equivalents-section");
      const eqList = document.getElementById("modal-equivalents-list");
      eqList.innerHTML = "";
      if (recipe.equivalents && recipe.equivalents.length > 0) {
        recipe.equivalents.forEach((eq) => {
          const div = document.createElement("div");
          div.className = "p-2.5 bg-[#FAF7F2] border border-[#EDE8DF] rounded-xl font-sans-recetario text-xs flex justify-between items-center";
          div.innerHTML = `<span class="text-slate-600 font-medium">${eq.group}:</span><span class="text-[#881337] font-bold font-mono-recetario text-sm">${eq.count}</span>`;
          eqList.appendChild(div);
        });
        eqSec.classList.remove("hidden");
      } else {
        eqSec.classList.add("hidden");
      }

      // Ingredients
      const ingList = document.getElementById("modal-ingredients-list");
      ingList.innerHTML = "";
      recipe.ingredients.forEach((ing, i) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-2.5 cursor-pointer py-1.5 select-none";
        li.innerHTML = `
          <input type="checkbox" id="ing-${i}" class="mt-0.5 rounded border-slate-300 accent-[#881337] cursor-pointer" />
          <label for="ing-${i}" class="cursor-pointer leading-tight text-slate-700 font-medium">${ing}</label>
        `;
        li.addEventListener("click", (e) => {
          if (e.target.tagName !== "INPUT") {
            const cb = li.querySelector("input");
            cb.checked = !cb.checked;
          }
          const label = li.querySelector("label");
          if (li.querySelector("input").checked) {
            label.classList.add("line-through", "text-slate-400");
          } else {
            label.classList.remove("line-through", "text-slate-400");
          }
        });
        ingList.appendChild(li);
      });

      // Instructions
      const instList = document.getElementById("modal-instructions-list");
      instList.innerHTML = "";
      recipe.instructions.forEach((step) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-3 py-1";
        li.innerHTML = `
          <span class="w-6 h-6 rounded-full bg-rose-100 text-[#881337] font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 font-mono-recetario">
            ${step.step}
          </span>
          <span class="leading-relaxed text-slate-800 text-sm font-normal">${step.text}</span>
        `;
        instList.appendChild(li);
      });

      // Tip
      const tipBox = document.getElementById("modal-tip-box");
      const tipText = document.getElementById("modal-tip-text");
      if (recipe.tip) {
        tipText.textContent = recipe.tip;
        tipBox.classList.remove("hidden");
      } else {
        tipBox.classList.add("hidden");
      }

      recipeModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeRecipeModal() {
      recipeModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function openUnlockModal() {
      const err = document.getElementById("unlock-error");
      if (err) err.classList.add("hidden");
      unlockModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        document.getElementById("vip-input-code")?.focus();
      }, 50);
    }

    function closeUnlockModal() {
      unlockModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    // Filter Logic
    function applyFilters() {
      const articles = document.querySelectorAll(".recipe-card");
      let visibleCount = 0;

      articles.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const tags = card.getAttribute("data-tags") || "";
        const title = card.getAttribute("data-title") || "";
        const ingredients = card.getAttribute("data-ingredients") || "";
        const isFree = card.getAttribute("data-free") === "true";

        let matchesCat = activeCategory === "todas" || cat === activeCategory;
        let matchesTag = !activeTag || tags.includes(activeTag);
        let matchesFree = !onlyFree || isFree;
        let matchesSearch = true;

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          matchesSearch = title.includes(q) || ingredients.includes(q) || tags.toLowerCase().includes(q);
        }

        if (matchesCat && matchesTag && matchesFree && matchesSearch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      const countSpan = document.getElementById("count-visible");
      if (countSpan) countSpan.textContent = visibleCount;

      const emptyState = document.getElementById("empty-state");
      const recipesGrid = document.getElementById("recipes-grid");
      if (visibleCount === 0) {
        emptyState?.classList.remove("hidden");
        recipesGrid?.classList.add("hidden");
      } else {
        emptyState?.classList.add("hidden");
        recipesGrid?.classList.remove("hidden");
      }

      // Filter feedback
      const feedback = document.getElementById("filter-feedback");
      const feedbackText = document.getElementById("filter-feedback-text");
      const activeFilters = [];
      if (activeCategory !== "todas") activeFilters.push(`Categoría: ${activeCategory}`);
      if (activeTag) activeFilters.push(`Etiqueta: ${activeTag}`);
      if (onlyFree) activeFilters.push("Solo Muestras Gratis");
      if (searchQuery) activeFilters.push(`Búsqueda: "${searchQuery}"`);

      if (activeFilters.length > 0 && feedback && feedbackText) {
        feedback.classList.remove("hidden");
        feedbackText.textContent = `FILTROS ACTIVOS: ${activeFilters.join(" | ")} (${visibleCount} recetas)`;
      } else if (feedback) {
        feedback.classList.add("hidden");
      }
    }

    // Event Listeners setup
    document.addEventListener("DOMContentLoaded", () => {
      checkAuth();

      // VIP Toggle in header
      document.getElementById("btn-vip-toggle")?.addEventListener("click", () => {
        if (isVip) {
          if (confirm("¿Deseas cerrar tu sesión VIP?")) {
            setAuth(false);
          }
        } else {
          openUnlockModal();
        }
      });

      document.getElementById("btn-hero-unlock")?.addEventListener("click", () => {
        openUnlockModal();
      });

      // Unlock modal form
      document.getElementById("unlock-form")?.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("vip-input-code");
        const val = input ? input.value.trim().toUpperCase() : "";
        const err = document.getElementById("unlock-error");

        if (VALID_CODES.includes(val)) {
          setAuth(true);
          closeUnlockModal();
          alert("¡Acceso VIP Activado! Las 185 recetas han sido desbloqueadas con éxito.");
        } else {
          if (err) err.classList.remove("hidden");
        }
      });

      document.getElementById("btn-close-unlock-modal")?.addEventListener("click", closeUnlockModal);
      unlockModal?.addEventListener("click", (e) => {
        if (e.target === unlockModal) closeUnlockModal();
      });

      // Recipe modal triggers
      document.addEventListener("click", (e) => {
        const btn = e.target.closest('[data-action="open-recipe"]');
        if (btn) {
          const recipeId = btn.getAttribute("data-recipe-id");
          if (recipeId) openRecipeModal(recipeId);
        }
      });

      document.getElementById("btn-close-modal")?.addEventListener("click", closeRecipeModal);
      document.getElementById("btn-close-modal-bottom")?.addEventListener("click", closeRecipeModal);
      recipeModal?.addEventListener("click", (e) => {
        if (e.target === recipeModal) closeRecipeModal();
      });

      // Escape key to close modals
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeRecipeModal();
          closeUnlockModal();
        }
      });

      // Category tab buttons
      const catBtns = document.querySelectorAll(".cat-tab-btn");
      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => {
            b.classList.remove("bg-[#881337]", "text-white", "border-[#881337]", "shadow-xs");
            b.classList.add("bg-white", "text-slate-700", "border-[#D8D2C5]");
          });
          btn.classList.remove("bg-white", "text-slate-700", "border-[#D8D2C5]");
          btn.classList.add("bg-[#881337]", "text-white", "border-[#881337]", "shadow-xs");

          activeCategory = btn.getAttribute("data-category") || "todas";
          applyFilters();
        });
      });

      // Tag filter buttons
      const tagBtns = document.querySelectorAll(".filter-tag-btn");
      tagBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-filter-tag");
          if (activeTag === tag) {
            activeTag = null;
            btn.classList.remove("bg-[#881337]", "text-white", "border-[#881337]");
            btn.classList.add("bg-white", "text-slate-700", "border-[#D8D2C5]");
          } else {
            tagBtns.forEach((b) => {
              b.classList.remove("bg-[#881337]", "text-white", "border-[#881337]");
              b.classList.add("bg-white", "text-slate-700", "border-[#D8D2C5]");
            });
            activeTag = tag;
            btn.classList.remove("bg-white", "text-slate-700", "border-[#D8D2C5]");
            btn.classList.add("bg-[#881337]", "text-white", "border-[#881337]");
          }
          applyFilters();
        });
      });

      // Free filter button
      const freeBtn = document.getElementById("filter-free-btn");
      freeBtn?.addEventListener("click", () => {
        onlyFree = !onlyFree;
        if (onlyFree) {
          freeBtn.classList.remove("bg-emerald-50", "text-emerald-800");
          freeBtn.classList.add("bg-emerald-700", "text-white");
        } else {
          freeBtn.classList.remove("bg-emerald-700", "text-white");
          freeBtn.classList.add("bg-emerald-50", "text-emerald-800");
        }
        applyFilters();
      });

      // Search input
      const searchInput = document.getElementById("recipe-search");
      const clearBtn = document.getElementById("clear-search-btn");
      searchInput?.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim();
        if (searchQuery) {
          clearBtn?.classList.remove("hidden");
        } else {
          clearBtn?.classList.add("hidden");
        }
        applyFilters();
      });

      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        clearBtn.classList.add("hidden");
        applyFilters();
      });

      // Reset filters
      const resetFilters = () => {
        activeCategory = "todas";
        activeTag = null;
        onlyFree = false;
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        clearBtn?.classList.add("hidden");

        catBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add("bg-[#881337]", "text-white", "border-[#881337]");
            b.classList.remove("bg-white", "text-slate-700", "border-[#D8D2C5]");
          } else {
            b.classList.remove("bg-[#881337]", "text-white", "border-[#881337]");
            b.classList.add("bg-white", "text-slate-700", "border-[#D8D2C5]");
          }
        });

        tagBtns.forEach((b) => {
          b.classList.remove("bg-[#881337]", "text-white");
          b.classList.add("bg-white", "text-slate-700");
        });

        if (freeBtn) {
          freeBtn.classList.remove("bg-emerald-700", "text-white");
          freeBtn.classList.add("bg-emerald-50", "text-emerald-800");
        }

        applyFilters();
      };

      document.getElementById("reset-all-filters")?.addEventListener("click", resetFilters);
      document.getElementById("btn-reset-empty")?.addEventListener("click", resetFilters);
    });
  </script>
</RecetarioLayout>
