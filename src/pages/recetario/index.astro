      toast.classList.remove("-translate-y-6", "opacity-0", "pointer-events-none");
      toast.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        hideToast();
      }, 4000);
    }

    function hideToast() {
      if (!toast) return;
      toast.classList.add("-translate-y-6", "opacity-0", "pointer-events-none");
      toast.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
    }

    document.getElementById("btn-close-toast")?.addEventListener("click", hideToast);

    // Logout Modal Logic
    const logoutModal = document.getElementById("logout-modal");

    function openLogoutModal() {
      logoutModal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeLogoutModal() {
      logoutModal?.classList.add("hidden");
      document.body.style.overflow = "";
    }

    document.getElementById("btn-cancel-logout")?.addEventListener("click", closeLogoutModal);
    document.getElementById("btn-confirm-logout")?.addEventListener("click", () => {
      setAuth(false);
      closeLogoutModal();
      showToast("Sesión cerrada", "Has cerrado tu sesión VIP correctamente.");
    });
    logoutModal?.addEventListener("click", (e) => {
      if (e.target === logoutModal) closeLogoutModal();
    });

    function checkAuth() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "true") {
          isVip = true;
        }
      } catch (e) {}
      updateAuthUI();
    }

    function setAuth(status) {
      isVip = status;
      try {
        if (status) {
          localStorage.setItem(STORAGE_KEY, "true");
        } else {
          localStorage.removeItem(STORAGE_KEY);
        }
      } catch (e) {}
      updateAuthUI();
      applyFilters();
    }

    function updateAuthUI() {
      const pillBtn = document.getElementById("btn-vip-header-pill");
      const pillText = document.getElementById("btn-vip-pill-text");
      const heroLocked = document.getElementById("hero-vip-locked");
      const heroUnlocked = document.getElementById("hero-vip-unlocked");

      const lockedBanner = document.getElementById("locked-recipes-banner");

      if (isVip) {
        if (pillText) pillText.textContent = "✓ VIP Activo (Cerrar)";
        if (pillBtn) pillBtn.className = "px-3 py-1 bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400 text-emerald-300 text-[11px] font-bold rounded-full transition-colors cursor-pointer";
        if (heroLocked) heroLocked.classList.add("hidden");
        if (heroUnlocked) heroUnlocked.classList.remove("hidden");
        if (lockedBanner) lockedBanner.classList.add("hidden");
      } else {
        if (pillText) pillText.textContent = "🔑 Ingresar Código";
        if (pillBtn) pillBtn.className = "px-3 py-1 bg-[#E6A635]/20 hover:bg-[#E6A635]/30 border border-[#E6A635]/50 text-[#F5D061] text-[11px] font-bold rounded-full transition-colors cursor-pointer";
        if (heroLocked) heroLocked.classList.remove("hidden");
        if (heroUnlocked) heroUnlocked.classList.add("hidden");
        if (lockedBanner) lockedBanner.classList.remove("hidden");
      }

      // Update card buttons
      const cardVipButtons = document.querySelectorAll(".card-vip-action");
      cardVipButtons.forEach((div) => {
        const btnAction = div.querySelector(".card-vip-btn");
        if (isVip) {
          if (btnAction) {
            btnAction.innerHTML = "<span>Ver Ficha Completa</span> <span>→</span>";
            btnAction.className = "card-vip-btn w-full py-3.5 px-4 bg-gradient-to-r from-[#991B32] via-[#800F24] to-[#991B32] hover:from-[#A51F38] hover:to-[#A51F38] border border-[#F5D061]/70 text-white font-bold text-xs uppercase tracking-wider rounded-2xl transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 shadow-[0_4px_16px_rgba(153,27,50,0.5)] hover:shadow-[0_6px_22px_rgba(245,208,97,0.35)] hover:-translate-y-0.5 active:scale-98";
          }
        } else {
          if (btnAction) {
            btnAction.innerHTML = "<span>🔒 Desbloquear Receta</span> <span>→</span>";
            btnAction.className = "card-vip-btn w-full py-3.5 px-4 bg-[#1E0308] hover:bg-[#340811] border border-[#E6A635]/40 hover:border-[#F5D061] text-amber-100 font-bold text-xs uppercase tracking-wider rounded-2xl transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 shadow-sm hover:shadow-[0_0_15px_rgba(230,166,53,0.25)] hover:-translate-y-0.5 active:scale-98";
          }
        }
      });
    }

    // Modal logic
    const recipeModal = document.getElementById("recipe-modal");
    const unlockModal = document.getElementById("unlock-modal");

    function openRecipeModal(recipeId) {
      const recipe = recipesData.find((r) => r.id === recipeId);
      if (!recipe) return;

      const isFree = FREE_SAMPLE_IDS.includes(recipeId);
      if (!isFree && !isVip) {
        openUnlockModal();
        return;
      }

      // Populate modal
      const modalImg = document.getElementById("modal-image");
      if (modalImg) {
        modalImg.src = recipe.image || "/images/recetas/001-champurrado-ligero.webp";
        modalImg.alt = recipe.title;
      }

      const modalCat = document.getElementById("modal-category");
      modalCat.textContent = recipe.category;

      document.getElementById("modal-page").textContent = "Receta #" + String(recipe.number).padStart(3, '0');
      document.getElementById("modal-title").textContent = recipe.title;
      document.getElementById("modal-calories").textContent = (recipe.calories || "150");
      document.getElementById("modal-time").textContent = recipe.prepTime.replace(/prep\.? estimada|preparaci[oó]n/i, "").trim();
      document.getElementById("modal-portions").textContent = recipe.portions.replace(/porci[oó]n(es)?/i, "").trim() || "1";

      // Nutrition
      document.getElementById("modal-prot").textContent = recipe.nutrition.protein || "N/D";
      document.getElementById("modal-fat").textContent = recipe.nutrition.fats || "N/D";
      document.getElementById("modal-carb").textContent = recipe.nutrition.carbs || "N/D";
      document.getElementById("modal-fib").textContent = recipe.nutrition.fiber || "N/D";

      // Equivalents
      const eqSec = document.getElementById("modal-equivalents-section");
      const eqList = document.getElementById("modal-equivalents-list");
      eqList.innerHTML = "";
      if (recipe.equivalents && recipe.equivalents.length > 0) {
        recipe.equivalents.forEach((eq) => {
          const div = document.createElement("div");
          div.className = "p-3 bg-[#1E0308] border border-[#E6A635]/35 rounded-2xl text-xs flex justify-between items-center";
          div.innerHTML = `<span class="text-amber-200/80 font-medium">${eq.group}:</span><span class="text-[#F5D061] font-bold font-mono-recetario text-sm">${eq.count}</span>`;
          eqList.appendChild(div);
        });
        eqSec.classList.remove("hidden");
      } else {
        eqSec.classList.add("hidden");
      }

      // Ingredients
      const ingList = document.getElementById("modal-ingredients-list");
      ingList.innerHTML = "";
      recipe.ingredients.forEach((ing, i) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-2.5 cursor-pointer py-1.5 select-none";
        li.innerHTML = `
          <input type="checkbox" id="ing-${i}" class="mt-0.5 rounded border-[#E6A635]/50 accent-[#E6A635] cursor-pointer" />
          <label for="ing-${i}" class="cursor-pointer leading-tight text-amber-100/90 font-medium">${ing}</label>
        `;
        li.addEventListener("click", (e) => {
          if (e.target.tagName !== "INPUT") {
            const cb = li.querySelector("input");
            cb.checked = !cb.checked;
          }
          const label = li.querySelector("label");
          if (li.querySelector("input").checked) {
            label.classList.add("line-through", "text-amber-200/40");
          } else {
            label.classList.remove("line-through", "text-amber-200/40");
          }
        });
        ingList.appendChild(li);
      });

      // Instructions
      const instList = document.getElementById("modal-instructions-list");
      instList.innerHTML = "";
      recipe.instructions.forEach((step) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-3 py-1";
        li.innerHTML = `
          <span class="w-6 h-6 rounded-full bg-[#E6A635]/20 border border-[#E6A635]/50 text-[#F5D061] font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 font-mono-recetario">
            ${step.step}
          </span>
          <span class="leading-relaxed text-amber-100 text-sm font-normal">${step.text}</span>
        `;
        instList.appendChild(li);
      });

      // Tip
      const tipBox = document.getElementById("modal-tip-box");
      const tipText = document.getElementById("modal-tip-text");
      if (recipe.tip) {
        tipText.textContent = recipe.tip;
        tipBox.classList.remove("hidden");
      } else {
        tipBox.classList.add("hidden");
      }

      recipeModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeRecipeModal() {
      recipeModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function openUnlockModal() {
      const err = document.getElementById("unlock-error");
      if (err) err.classList.add("hidden");
      unlockModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        document.getElementById("vip-input-code")?.focus();
      }, 50);
    }

    function closeUnlockModal() {
      unlockModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    // Filter Logic
    function applyFilters() {
      const articles = document.querySelectorAll(".recipe-card");
      let visibleCount = 0;

      articles.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const tags = card.getAttribute("data-tags") || "";
        const title = card.getAttribute("data-title") || "";
        const ingredients = card.getAttribute("data-ingredients") || "";
        const isFree = card.getAttribute("data-free") === "true";

        // SI NO TIENE LA CONTRASEÑA (NO VIP), LAS RECETAS QUE NO SON DE MUESTRA QUEDAN COMPLETAMENTE OCULTAS
        if (!isVip && !isFree) {
          card.classList.add("hidden");
          return;
        }

        let matchesCat = activeCategory === "todas" || cat === activeCategory;
        let matchesTag = !activeTag || tags.includes(activeTag);
        let matchesFree = !onlyFree || isFree;
        let matchesSearch = true;

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          matchesSearch = title.includes(q) || ingredients.includes(q) || tags.toLowerCase().includes(q);
        }

        if (matchesCat && matchesTag && matchesFree && matchesSearch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      const countSpan = document.getElementById("count-visible");
      if (countSpan) {
        if (isVip) {
          countSpan.textContent = visibleCount;
        } else {
          countSpan.textContent = `${visibleCount} de muestra (179 bloqueadas)`;
        }
      }

      const emptyState = document.getElementById("empty-state");
      const recipesGrid = document.getElementById("recipes-grid");
      if (visibleCount === 0) {
        emptyState?.classList.remove("hidden");
        recipesGrid?.classList.add("hidden");
      } else {
        emptyState?.classList.add("hidden");
        recipesGrid?.classList.remove("hidden");
      }

      // Filter feedback
      const feedback = document.getElementById("filter-feedback");
      const feedbackText = document.getElementById("filter-feedback-text");
      const activeFilters = [];
      if (activeCategory !== "todas") activeFilters.push(`Categoría: ${activeCategory}`);
      if (activeTag) activeFilters.push(`Etiqueta: ${activeTag}`);
      if (onlyFree) activeFilters.push("Solo Muestras Gratis");
      if (searchQuery) activeFilters.push(`Búsqueda: "${searchQuery}"`);

      if (activeFilters.length > 0 && feedback && feedbackText) {
        feedback.classList.remove("hidden");
        feedbackText.textContent = `FILTROS: ${activeFilters.join(" | ")} (${visibleCount} recetas)`;
      } else if (feedback) {
        feedback.classList.add("hidden");
      }
    }

    // Event Listeners setup
    document.addEventListener("DOMContentLoaded", () => {
      checkAuth();

      // VIP Toggle in header
      document.getElementById("btn-vip-header-pill")?.addEventListener("click", () => {
        if (isVip) {
          openLogoutModal();
        } else {
          openUnlockModal();
        }
      });

      document.getElementById("btn-hero-unlock")?.addEventListener("click", () => {
        openUnlockModal();
      });

      document.getElementById("btn-banner-unlock")?.addEventListener("click", () => {
        openUnlockModal();
      });

      // Unlock modal form
      document.getElementById("unlock-form")?.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("vip-input-code");
        const val = input ? input.value.trim().toUpperCase() : "";
        const err = document.getElementById("unlock-error");

        if (VALID_CODES.includes(val)) {
          setAuth(true);
          closeUnlockModal();
          showToast("¡Acceso VIP Activado!", "Las 185 recetas completas han sido desbloqueadas con éxito.");
        } else {
          if (err) err.classList.remove("hidden");
        }
      });

      document.getElementById("btn-close-unlock-modal")?.addEventListener("click", closeUnlockModal);
      unlockModal?.addEventListener("click", (e) => {
        if (e.target === unlockModal) closeUnlockModal();
      });

      // Recipe modal triggers
      document.addEventListener("click", (e) => {
        const btn = e.target.closest('[data-action="open-recipe"]');
        if (btn) {
          const recipeId = btn.getAttribute("data-recipe-id");
          if (recipeId) openRecipeModal(recipeId);
        }
      });

      document.getElementById("btn-close-modal")?.addEventListener("click", closeRecipeModal);
      document.getElementById("btn-close-modal-bottom")?.addEventListener("click", closeRecipeModal);
      recipeModal?.addEventListener("click", (e) => {
        if (e.target === recipeModal) closeRecipeModal();
      });

      // Escape key to close modals
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeRecipeModal();
          closeUnlockModal();
          closeLogoutModal();
        }
      });

      // Category tab buttons
      const catBtns = document.querySelectorAll(".cat-tab-btn");
      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => {
            b.className = "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]";
          });
          btn.className = "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]";

          activeCategory = btn.getAttribute("data-category") || "todas";
          applyFilters();
        });
      });

      // Tag filter buttons
      const tagBtns = document.querySelectorAll(".filter-tag-btn");
      tagBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-filter-tag");
          if (activeTag === tag) {
            activeTag = null;
            btn.className = "filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
          } else {
            tagBtns.forEach((b) => {
              b.className = "filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
            });
            activeTag = tag;
            btn.className = "filter-tag-btn text-xs font-bold px-4 py-2.5 bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] border border-[#FFF0C0] rounded-full whitespace-nowrap cursor-pointer transition-all shadow-md active:scale-95";
          }
          applyFilters();
        });
      });

      // Free filter button
      const freeBtn = document.getElementById("filter-free-btn");
      freeBtn?.addEventListener("click", () => {
        onlyFree = !onlyFree;
        if (onlyFree) {
          freeBtn.className = "text-xs font-bold px-4 py-2.5 bg-emerald-500 text-white border border-emerald-300 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-[0_0_15px_rgba(52,211,153,0.4)] active:scale-95";
        } else {
          freeBtn.className = "text-xs font-bold px-4 py-2.5 bg-emerald-950/80 border border-emerald-400/60 text-emerald-300 hover:bg-emerald-600 hover:text-white rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
        }
        applyFilters();
      });

      // Search input
      const searchInput = document.getElementById("recipe-search");
      const clearBtn = document.getElementById("clear-search-btn");
      searchInput?.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim();
        if (searchQuery) {
          clearBtn?.classList.remove("hidden");
        } else {
          clearBtn?.classList.add("hidden");
        }
        applyFilters();
      });

      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        clearBtn.classList.add("hidden");
        applyFilters();
      });

      // Reset filters
      const resetFilters = () => {
        activeCategory = "todas";
        activeTag = null;
        onlyFree = false;
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        clearBtn?.classList.add("hidden");

        catBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.className = "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]";
          } else {
            b.className = "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]";
          }
        });

        tagBtns.forEach((b) => {
          b.className = "filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
        });

        if (freeBtn) {
          freeBtn.className = "text-xs font-bold px-4 py-2.5 bg-emerald-950/80 border border-emerald-400/60 text-emerald-300 hover:bg-emerald-600 hover:text-white rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
        }

        applyFilters();
      };

      document.getElementById("reset-all-filters")?.addEventListener("click", resetFilters);
      document.getElementById("btn-reset-empty")?.addEventListener("click", resetFilters);
    });
  </script>
</Layout>
