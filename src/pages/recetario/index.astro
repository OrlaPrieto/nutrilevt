---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import recipesData from "../../data/recipes.json";

// Free preview sample recipe IDs (one per major chapter)
const FREE_SAMPLE_IDS = [
  "001-champurrado-ligero",
  "043-ensalada-campera",
  "085-lomo-de-cerdo-con-champinones",
  "125-pure-de-camote-con-canela",
  "151-trufas-de-datil-y-cacao",
  "176-mousse-de-aguacate-y-cacao"
];

const totalRecipes = recipesData.length;
const categoryCounts = recipesData.reduce((acc, r) => {
  acc[r.categorySlug] = (acc[r.categorySlug] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = [
  { name: "Todas", slug: "todas", count: totalRecipes },
  { name: "Bebidas", slug: "bebidas", count: categoryCounts["bebidas"] || 0 },
  { name: "Ensaladas", slug: "ensaladas", count: categoryCounts["ensaladas"] || 0 },
  { name: "Platos Fuertes", slug: "platos-fuertes", count: categoryCounts["platos-fuertes"] || 0 },
  { name: "Guarniciones", slug: "guarniciones", count: categoryCounts["guarniciones"] || 0 },
  { name: "Postres", slug: "postres", count: categoryCounts["postres"] || 0 },
  { name: "Diabetes", slug: "diabetes", count: categoryCounts["diabetes"] || 0 },
];

// Color contours and badges by category matching the holiday aesthetic
function getCategoryContour(slug: string) {
  switch (slug) {
    case "bebidas":
      return {
        border: "border-rose-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(251,113,133,0.35)]",
        badge: "bg-rose-500/20 text-rose-300 border-rose-400/50",
        accent: "#FB7185",
        label: "Bebidas"
      };
    case "ensaladas":
      return {
        border: "border-emerald-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(52,211,153,0.35)]",
        badge: "bg-emerald-500/20 text-emerald-300 border-emerald-400/50",
        accent: "#34D399",
        label: "Ensaladas"
      };
    case "platos-fuertes":
      return {
        border: "border-red-500/90",
        glow: "hover:shadow-[0_0_25px_rgba(239,68,68,0.35)]",
        badge: "bg-red-500/20 text-red-300 border-red-400/50",
        accent: "#EF4444",
        label: "Platos Fuertes"
      };
    case "guarniciones":
      return {
        border: "border-amber-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(251,191,36,0.35)]",
        badge: "bg-amber-500/20 text-amber-300 border-amber-400/50",
        accent: "#FBBF24",
        label: "Guarniciones"
      };
    case "postres":
      return {
        border: "border-yellow-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(250,204,21,0.35)]",
        badge: "bg-yellow-500/20 text-yellow-300 border-yellow-400/50",
        accent: "#FACC15",
        label: "Postres"
      };
    case "diabetes":
      return {
        border: "border-cyan-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(34,211,238,0.35)]",
        badge: "bg-cyan-500/20 text-cyan-300 border-cyan-400/50",
        accent: "#22D3EE",
        label: "Diabetes"
      };
    default:
      return {
        border: "border-amber-400/90",
        glow: "hover:shadow-[0_0_25px_rgba(251,191,36,0.35)]",
        badge: "bg-amber-500/20 text-amber-300 border-amber-400/50",
        accent: "#FBBF24",
        label: "Receta"
      };
  }
}
---

<Layout
  title="Recetario Navideño 2026 · Edición Clínica VIP | Nutrilev"
  description="185 recetas navideñas con respaldo clínico, porciones controladas y conteo de equivalentes SMAE por la Nutrióloga Velvet De la Cruz."
  hideFloatingCTA={true}
>
  <!-- Google Fonts: Script, Playfair Display, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />

  <style is:inline>
    .font-script {
      font-family: 'Dancing Script', cursive, sans-serif;
    }
    .font-display {
      font-family: 'Playfair Display', Georgia, serif;
    }
    .font-sans-recetario {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-mono-recetario {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
    }

    /* Festive background pattern with subtle snowflake watermarks */
    .bg-holiday-canvas {
      background: radial-gradient(circle at 15% 10%, #520f1c 0%, #350811 50%, #20040a 100%);
      background-attachment: fixed;
    }

    /* Asegurar fondo vino festivo y título dorado permanentemente visible en tarjetas */
    .recipe-card {
      background-color: #28050D !important;
      color: #ffffff !important;
    }
    .recipe-card h3 {
      color: #F5D061 !important;
    }
    .recipe-card:hover h3 {
      color: #FFFFFF !important;
    }

    /* Custom print styles for recipe detail */
    @media print {
      header, nav, footer, #filter-section, #vip-banner, .no-print {
        display: none !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      #recipe-modal {
        position: static !important;
        background: none !important;
        padding: 0 !important;
      }
      #recipe-modal-dialog {
        box-shadow: none !important;
        border: none !important;
        max-width: 100% !important;
        width: 100% !important;
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <!-- MISMO HEADER / NAVBAR QUE TODA LA PÁGINA WEB -->
  <Navbar />

  <!-- CONTENEDOR PRINCIPAL CON EL FONDO NAVIDEÑO DE LA IMAGEN (VINO PROFUNDO Y DESTELLOS DORADOS) -->
  <div class="bg-holiday-canvas text-white pt-24 sm:pt-32 pb-20 min-h-screen relative overflow-hidden font-sans-recetario selection:bg-[#E6A635] selection:text-[#2E060E]">
    
    <!-- Ambient Christmas botanical glowing lights -->
    <div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-red-600/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-80 right-10 w-[450px] h-[450px] bg-amber-500/10 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-40 left-10 w-[550px] h-[550px] bg-emerald-600/10 rounded-full blur-[150px] pointer-events-none"></div>

    <!-- HERO EDITORIAL FESTIVO -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 sm:pb-16 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Headline & Manifesto -->
        <div class="lg:col-span-7">
          <!-- Holiday Festive Tag -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#E6A635]/15 border border-[#E6A635]/40 text-[#F5D061] text-xs font-bold uppercase tracking-wider mb-5 backdrop-blur-md shadow-[0_0_15px_rgba(230,166,53,0.15)]">
            <span>✨</span>
            <span>Edición Navideña 2026 · 716 Páginas</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#E6A635]"></span>
            <span>185 Recetas</span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl lg:text-5.5xl text-white font-bold leading-[1.12] tracking-tight mb-5">
            El arte de celebrar con bienestar: <span class="font-script text-4xl sm:text-6xl lg:text-7xl text-[#F5D061] block font-normal mt-1">185 recetas navideñas</span> con respaldo clínico.
          </h1>

          <p class="text-amber-100/80 text-base sm:text-lg leading-relaxed max-w-2xl font-light">
            Recetario exclusivo desarrollado por la <strong class="text-white font-semibold">Nutrióloga Velvet De la Cruz Villegas</strong> (Céd. Prof. 10622381) para disfrutar las cenas decembrinas con equilibrio metabólico, cálculo de porciones y equivalentes del <strong>SMAE</strong> y alternativas seguras para personas con diabetes.
          </p>
        </div>

        <!-- Right: VIP Card con marco metálico dorado -->
        <div class="lg:col-span-5 p-1 bg-gradient-to-br from-[#F5D061] via-[#E6A635] to-[#B37B1B] rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.5)]">
          <div class="bg-[#2B050D] p-6 sm:p-8 rounded-[22px]">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E6A635]/25">
              <span class="text-xs font-bold uppercase tracking-wider text-[#F5D061] flex items-center gap-2">
                <span>⭐</span>
                <span>Recetario Navideño Completo</span>
              </span>
              <span class="text-[11px] font-bold px-3 py-1 bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] rounded-full shadow-sm">
                Edición 2026
              </span>
            </div>

            <div id="hero-vip-locked">
              <h2 class="font-display text-2xl text-white font-bold mb-2">
                Desbloquea las 185 Recetas
              </h2>
              <p class="text-amber-100/75 text-sm leading-relaxed mb-6">
                Tienes <strong>6 recetas de muestra gratuitas</strong> disponibles. Para tener acceso ilimitado a las 185 recetas completas con fotografías, porciones e información nutricional, ingresa tu código VIP o adquiérelo por WhatsApp.
              </p>

              <div class="space-y-3">
                <!-- Botón único con brillo dorado -->
                <button
                  type="button"
                  id="btn-hero-unlock"
                  class="w-full py-4 px-5 bg-gradient-to-r from-[#991B32] via-[#800F24] to-[#991B32] hover:from-[#A51F38] hover:to-[#A51F38] border border-[#F5D061]/70 text-white font-bold text-sm rounded-2xl transition-all duration-300 shadow-[0_4px_20px_rgba(153,27,50,0.6)] hover:shadow-[0_6px_25px_rgba(245,208,97,0.4)] hover:-translate-y-0.5 active:scale-98 cursor-pointer flex items-center justify-center gap-2"
                >
                  <span>🔑</span>
                  <span>Ingresar Código de Acceso</span>
                </button>

                <!-- Botón único esmeralda de WhatsApp -->
                <a
                  href="https://wa.me/526143958598?text=Hola%20Nutri%C3%B3loga%20Velvet,%20me%20interesa%20adquirir%20el%20Recetario%20Navide%C3%B1o%202026%20completo%20(185%20recetas)."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3.5 px-5 bg-gradient-to-r from-[#0F5132] via-[#157347] to-[#0F5132] hover:from-[#13653F] hover:to-[#13653F] border border-emerald-400/50 text-white font-bold text-sm rounded-2xl transition-all duration-300 shadow-[0_4px_16px_rgba(21,115,71,0.5)] hover:shadow-[0_6px_25px_rgba(52,211,153,0.4)] hover:-translate-y-0.5 active:scale-98 text-center flex items-center justify-center gap-2"
                >
                  <span>💬</span>
                  <span>Comprar Acceso por WhatsApp</span>
                </a>
              </div>
            </div>

            <div id="hero-vip-unlocked" class="hidden">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 rounded-full text-xs font-bold mb-3">
                <span>✓</span>
                <span>SESIÓN VIP AUTORIZADA</span>
              </div>
              <h2 class="font-display text-2xl text-white font-bold mb-2">
                ¡Bienvenido a tu Recetario Completo!
              </h2>
              <p class="text-amber-100/75 text-sm mb-6">
                Tienes acceso total a las 185 recetas con fotografías en alta definición, tabla de equivalentes clínicos del SMAE y buscador interactivo.
              </p>
              <div class="p-4 bg-[#1E0308] border border-[#E6A635]/40 rounded-2xl text-sm font-semibold text-white flex items-center justify-between">
                <span class="text-[#E6A635]">ESTADO:</span>
                <span class="text-emerald-400 font-bold font-mono-recetario">185 RECETAS ACTIVAS</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- BARRA DE CONTROLES, BÚSQUEDA Y FILTROS ESTILIZADA -->
    <section class="border-y border-[#E6A635]/25 bg-[#2B050D]/90 backdrop-blur-xl sticky top-16 sm:top-20 z-20 shadow-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        
        <!-- Top Row: Search and Quick Filters -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3.5 mb-4">
          <!-- Unique Bespoke Search Input with Gold Accent -->
          <div class="relative flex-1 group">
            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-[#F5D061] pointer-events-none">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              id="recipe-search"
              type="search"
              placeholder="Buscar por receta o ingrediente (pavo, lomo, ponche, chía, cacao)..."
              class="w-full h-12.5 pl-12 pr-12 bg-[#1E0308]/90 hover:bg-[#1E0308] focus:bg-[#20040A] border border-[#E6A635]/40 focus:border-[#F5D061] focus:ring-4 focus:ring-[#E6A635]/20 rounded-2xl text-sm text-white placeholder-amber-200/40 focus:outline-none transition-all shadow-inner"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#E6A635]/20 hover:bg-[#E6A635]/40 text-[#F5D061] flex items-center justify-center text-xs font-bold transition-colors cursor-pointer"
            >
              ✕
            </button>
          </div>

          <!-- Quick Tag Filter Chips -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 scrollbar-none">
            <button
              type="button"
              data-filter-tag="Sin azúcar añadida"
              class="filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Sin azúcar
            </button>
            <button
              type="button"
              data-filter-tag="Baja en grasa"
              class="filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Baja en grasa
            </button>
            <button
              type="button"
              data-filter-tag="Rica en proteína"
              class="filter-tag-btn text-xs font-semibold px-4 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Con proteína
            </button>
            <button
              type="button"
              data-filter-free="true"
              id="filter-free-btn"
              class="text-xs font-bold px-4 py-2.5 bg-emerald-950/80 border border-emerald-400/60 text-emerald-300 hover:bg-emerald-600 hover:text-white rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              ★ Muestras Gratis [6]
            </button>
          </div>
        </div>

        <!-- Bottom Row: Category Tabs con estilo cinta festiva dorada -->
        <div class="flex items-center justify-between gap-4 overflow-x-auto scrollbar-none pt-1">
          <div class="flex items-center gap-2 flex-nowrap">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat.slug}
                class={`cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border ${
                  idx === 0
                    ? "bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]"
                    : "bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]"
                }`}
              >
                <span>{cat.name}</span>
                <span class="opacity-80 ml-1.5 text-[11px] font-mono-recetario">({cat.count})</span>
              </button>
            ))}
          </div>

          <div class="hidden lg:flex items-center gap-3 text-xs text-amber-200/70 whitespace-nowrap">
            <span>Visibles: <strong id="count-visible" class="text-[#F5D061] font-mono-recetario font-bold">185</strong> / 185</span>
            <button
              id="btn-vip-header-pill"
              type="button"
              class="px-3 py-1 bg-[#E6A635]/20 hover:bg-[#E6A635]/30 border border-[#E6A635]/50 text-[#F5D061] text-[11px] font-bold rounded-full transition-colors cursor-pointer"
            >
              <span id="btn-vip-pill-text">Sesión VIP</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- CATÁLOGO DE 185 TARJETAS CON CONTORNO DE COLOR POR CATEGORÍA -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 relative z-10">
      
      <!-- Feedback de Filtros Activos -->
      <div id="filter-feedback" class="hidden mb-6 p-4 bg-[#28050D] border border-[#E6A635]/40 rounded-2xl flex items-center justify-between text-xs font-semibold text-amber-100 shadow-md">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#F5D061] animate-ping"></span>
          <span id="filter-feedback-text">Filtros activos</span>
        </div>
        <button id="reset-all-filters" type="button" class="text-[#F5D061] hover:underline font-bold px-3 py-1 rounded-lg hover:bg-[#3D0A14] transition-colors cursor-pointer">
          Limpiar Filtros ✕
        </button>
      </div>

      <!-- Empty Results State -->
      <div id="empty-state" class="hidden text-left py-16 px-8 bg-[#2A050D] border border-[#E6A635]/30 rounded-3xl shadow-xl">
        <div class="text-xs font-bold uppercase tracking-wider text-[#F5D061] mb-2">[0 RESULTADOS]</div>
        <h2 class="font-display text-3xl text-white mb-3 font-bold">No encontramos recetas con ese criterio</h2>
        <p class="text-amber-100/75 text-sm max-w-md mb-6 leading-relaxed font-light">
          Prueba buscando con términos como "lomo", "pavo", "chocolate", "manzana" o selecciona la categoría "Todas".
        </p>
        <button
          id="btn-reset-empty"
          type="button"
          class="text-xs font-bold uppercase tracking-wider px-6 py-3 bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] rounded-xl cursor-pointer hover:shadow-[0_0_20px_rgba(230,166,53,0.4)] transition-all"
        >
          Restaurar Catálogo Completo
        </button>
      </div>

      <!-- Grid de 185 Recetas -->
      <div id="recipes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 sm:gap-8">
        {recipesData.map((recipe) => {
          const isFree = FREE_SAMPLE_IDS.includes(recipe.id);
          const style = getCategoryContour(recipe.categorySlug);

          return (
            <article
              data-id={recipe.id}
              data-category={recipe.categorySlug}
              data-calories={recipe.calories}
              data-tags={recipe.tags.join("|")}
              data-title={recipe.title.toLowerCase()}
              data-ingredients={recipe.ingredients.join(" ").toLowerCase()}
              data-free={isFree ? "true" : "false"}
              class={`recipe-card bg-[#28050D]/95 backdrop-blur-md rounded-3xl p-5 border-2 ${style.border} ${style.glow} flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-2xl group relative ${!isFree ? "hidden" : ""}`}
            >
              <div>
                <!-- Top Dish Photo con Marco Dorado idéntico a la imagen del PDF -->
                <div class="p-1 bg-gradient-to-br from-[#F5D061] via-[#E6A635] to-[#996813] rounded-2xl shadow-md mb-5 overflow-hidden">
                  <div class="relative w-full h-56 rounded-[14px] overflow-hidden bg-[#1E0308] cursor-pointer" data-action="open-recipe" data-recipe-id={recipe.id}>
                    {recipe.image ? (
                      <img
                        src={recipe.image}
                        alt={recipe.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-amber-200/50 text-xs">
                        Fotografía de platillo
                      </div>
                    )}

                    <!-- Overlay sutil -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

                    <!-- Category Badge & Free Sample -->
                    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                      <span class={`text-[11px] font-bold px-3 py-1 rounded-full border shadow-sm backdrop-blur-md ${style.badge}`}>
                        {recipe.category}
                      </span>
                      {isFree && (
                        <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-emerald-600 text-white shadow-sm border border-emerald-400">
                          ★ Muestra Libre
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Sub-header Ficha de Receta en Oro (Igual al PDF) -->
                <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-[#E6A635]/20">
                  <span class="font-bold text-[11px] uppercase tracking-widest text-[#E6A635]">
                    FICHA DE RECETA
                  </span>
                  <span class="text-[11px] text-[#F5D061]/80 font-mono-recetario uppercase tracking-wider font-semibold">
                    {recipe.category}
                  </span>
                </div>

                <!-- Recipe Title (Letra cursiva festiva en oro permanente, visible siempre) -->
                <h3
                  data-action="open-recipe"
                  data-recipe-id={recipe.id}
                  class="font-script text-3xl sm:text-3.5xl text-[#F5D061] hover:text-white font-bold leading-tight mb-4 cursor-pointer transition-colors"
                >
                  {recipe.title}
                </h3>

                <!-- 3 Metric Boxes con borde dorado idénticos a la imagen del PDF -->
