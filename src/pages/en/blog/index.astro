---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/sections/Navbar.astro";
import Footer from "../../../components/sections/Footer.astro";
import WhatsAppFloat from "../../../components/ui/WhatsAppFloat.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import BlogCTA from "../../../components/blog/BlogCTA.astro";
import { getPublishedPosts } from "../../../lib/blog";
import { useTranslations } from "../../../i18n/utils";

const lang = 'en';
const t = useTranslations(lang);
const posts = await getPublishedPosts('en');
---

<Layout
  title={`${t('blog.title')} | Nutrilev Specialized`}
  description={t('blog.subtitle')}
  lang={lang}
>
  <Navbar />
  <WhatsAppFloat />

  <main class="pt-32 pb-24 min-h-screen bg-slate-50/50">
    <!-- Hero Header -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-100/70 text-primary text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        {t('blog.badge')}
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 tracking-tight">
        {t('blog.title')}
      </h1>
      <p class="text-slate-600 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        {t('blog.subtitle')}
      </p>
    </section>

    <!-- Articles Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts && posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <BlogCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-3xl border border-slate-100 shadow-sm max-w-2xl mx-auto px-6">
          <div class="w-16 h-16 bg-pink-50 text-primary rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">New Articles Coming Soon</h2>
          <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">
            We are preparing evidence-based articles and specialized nutrition guides.
          </p>
          <a
            href="/en/#booking"
            class="inline-block px-6 py-3 bg-primary text-white rounded-full text-sm font-semibold hover:bg-primary-hover transition-colors shadow-sm"
          >
            Book Consultation
          </a>
        </div>
      )}

      <!-- Bottom CTA -->
      <BlogCTA lang={lang} />
    </section>
  </main>

  <Footer />
</Layout>
