  <!-- SCRIPT DE INTERACCIÓN CLIENTE -->
  <script
    is:inline
    data-astro-rerun
    define:vars={{ recipesData, FREE_SAMPLE_IDS }}
  >
    // Única contraseña válida para acceso completo al recetario
    const VALID_PASSCODE = "Cuidandomeal100";

    const STORAGE_KEY = "nutrilev_recetario_vip_active";

    // Application state
    let isVip = false;
    let activeCategory = "todas";
    let activeTags = new Set();
    let onlyFree = false;
    let searchQuery = "";
    let calorieRange = "all";

    // Toast logic
    const toast = document.getElementById("toast-notification");
    const toastTitle = document.getElementById("toast-title");
    const toastMessage = document.getElementById("toast-message");
    let toastTimeout = null;

    function showToast(title, message) {
      if (!toast) return;
      if (toastTitle) toastTitle.textContent = title;
      if (toastMessage) toastMessage.textContent = message;

      toast.classList.remove(
        "-translate-y-6",
        "opacity-0",
        "pointer-events-none",
      );
      toast.classList.add(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        hideToast();
      }, 4000);
    }

    function hideToast() {
      if (!toast) return;
      toast.classList.add("-translate-y-6", "opacity-0", "pointer-events-none");
      toast.classList.remove(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );
    }

    document
      .getElementById("btn-close-toast")
      ?.addEventListener("click", hideToast);

    // Logout Modal Logic
    const logoutModal = document.getElementById("logout-modal");

    function openLogoutModal() {
      logoutModal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeLogoutModal() {
      logoutModal?.classList.add("hidden");
      document.body.style.overflow = "";
    }

    document
      .getElementById("btn-cancel-logout")
      ?.addEventListener("click", closeLogoutModal);
    document
      .getElementById("btn-confirm-logout")
      ?.addEventListener("click", () => {
        setAuth(false);
        closeLogoutModal();
        showToast("Sesión cerrada", "Has cerrado tu sesión VIP correctamente.");
      });
    logoutModal?.addEventListener("click", (e) => {
      if (e.target === logoutModal) closeLogoutModal();
    });

    function checkAuth() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "true") {
          isVip = true;
        }
      } catch (e) {}
      updateAuthUI();
    }

    function setAuth(status) {
      isVip = status;
      try {
        if (status) {
          localStorage.setItem(STORAGE_KEY, "true");
        } else {
          localStorage.removeItem(STORAGE_KEY);
        }
      } catch (e) {}
      updateAuthUI();
      applyFilters();
    }

    function updateAuthUI() {
      const pillBtn = document.getElementById("btn-vip-header-pill");
      const pillText = document.getElementById("btn-vip-pill-text");
      const heroLocked = document.getElementById("hero-vip-locked");
      const heroUnlocked = document.getElementById("hero-vip-unlocked");

      const lockedBanner = document.getElementById("locked-recipes-banner");

      if (isVip) {
        if (pillText) pillText.textContent = "VIP Activo";
        if (pillBtn)
          pillBtn.className =
            "px-3 py-1 bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/50 text-emerald-300 text-[11px] font-medium rounded-full transition-colors cursor-pointer";
        if (heroLocked) heroLocked.classList.add("hidden");
        if (heroUnlocked) heroUnlocked.classList.remove("hidden");
        if (lockedBanner) lockedBanner.classList.add("hidden");
      } else {
        if (pillText) pillText.textContent = "Ingresar Código";
        if (pillBtn)
          pillBtn.className =
            "px-3 py-1 bg-[#E6A635]/15 hover:bg-[#E6A635]/25 border border-[#E6A635]/40 text-[#F5D061] text-[11px] font-medium rounded-full transition-colors cursor-pointer";
        if (heroLocked) heroLocked.classList.remove("hidden");
        if (heroUnlocked) heroUnlocked.classList.add("hidden");
        if (lockedBanner) lockedBanner.classList.remove("hidden");
      }

      // Update card buttons
      const cardVipButtons = document.querySelectorAll(".card-vip-action");
      cardVipButtons.forEach((div) => {
        const btnAction = div.querySelector(".card-vip-btn");
        if (isVip) {
          if (btnAction) {
            btnAction.innerHTML =
              '<span>Ver Receta Completa</span> <svg class="w-4 h-4 text-[#28050D] transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>';
            btnAction.className =
              "card-vip-btn w-full py-3 px-4 bg-gradient-to-r from-[#E6A635] via-[#F5D061] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] font-extrabold text-xs sm:text-sm uppercase tracking-wider rounded-xl transition-all duration-200 shadow-[0_4px_16px_rgba(230,166,53,0.35)] hover:shadow-[0_6px_22px_rgba(245,208,97,0.5)] active:scale-98 cursor-pointer flex items-center justify-center gap-2 group/btn";
          }
        } else {
          if (btnAction) {
            btnAction.innerHTML =
              '<svg class="w-4 h-4 text-[#F5D061]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg> <span>Desbloquear Receta</span>';
            btnAction.className =
              "card-vip-btn w-full py-3 px-4 bg-[#1E0308] hover:bg-[#340811] border border-[#E6A635]/40 hover:border-[#F5D061] text-amber-200 hover:text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all duration-200 cursor-pointer flex items-center justify-center gap-2";
          }
        }
      });
    }

    // Modal logic
    const recipeModal = document.getElementById("recipe-modal");
    const unlockModal = document.getElementById("unlock-modal");

    function openRecipeModal(recipeId) {
      const recipe = recipesData.find((r) => r.id === recipeId);
      if (!recipe) return;

      const isFree = FREE_SAMPLE_IDS.includes(recipeId);
      if (!isFree && !isVip) {
        openUnlockModal();
        return;
      }

      // Populate modal
      const modalImg = document.getElementById("modal-image");
      if (modalImg) {
        modalImg.src =
          recipe.image || "/images/recetas/001-champurrado-ligero.webp";
        modalImg.alt = recipe.title;
      }

      const modalCat = document.getElementById("modal-category");
      modalCat.textContent = recipe.category;

      document.getElementById("modal-page").textContent =
        "Receta #" + String(recipe.number).padStart(3, "0");
      document.getElementById("modal-title").textContent = recipe.title;
      document.getElementById("modal-calories").textContent =
        recipe.calories || "150";
      document.getElementById("modal-time").textContent = recipe.prepTime
        .replace(/prep\.? estimada|preparaci[oó]n/i, "")
        .trim();
      document.getElementById("modal-portions").textContent =
        recipe.portions.replace(/porci[oó]n(es)?/i, "").trim() || "1";

      // Nutrition
      document.getElementById("modal-prot").textContent =
        recipe.nutrition.protein || "N/D";
      document.getElementById("modal-fat").textContent =
        recipe.nutrition.fats || "N/D";
      document.getElementById("modal-carb").textContent =
        recipe.nutrition.carbs || "N/D";
      document.getElementById("modal-fib").textContent =
        recipe.nutrition.fiber || "N/D";

      // Equivalents
      const eqSec = document.getElementById("modal-equivalents-section");
      const eqList = document.getElementById("modal-equivalents-list");
      eqList.innerHTML = "";
      if (recipe.equivalents && recipe.equivalents.length > 0) {
        recipe.equivalents.forEach((eq) => {
          const div = document.createElement("div");
          div.className =
            "p-3 bg-[#1E0308] border border-[#E6A635]/35 rounded-2xl text-xs flex justify-between items-center";
          div.innerHTML = `<span class="text-amber-200/80 font-medium">${eq.group}:</span><span class="text-[#F5D061] font-bold font-mono-recetario text-sm">${eq.count}</span>`;
          eqList.appendChild(div);
        });
        eqSec.classList.remove("hidden");
      } else {
        eqSec.classList.add("hidden");
      }

      // Ingredients
      const ingList = document.getElementById("modal-ingredients-list");
      ingList.innerHTML = "";
      recipe.ingredients.forEach((ing, i) => {
        const li = document.createElement("li");
        li.className =
          "flex items-start gap-2.5 cursor-pointer py-1.5 select-none";
        li.innerHTML = `
          <input type="checkbox" id="ing-${i}" class="mt-0.5 rounded border-[#E6A635]/50 accent-[#E6A635] cursor-pointer" />
          <label for="ing-${i}" class="cursor-pointer leading-tight text-amber-100/90 font-medium">${ing}</label>
        `;
        li.addEventListener("click", (e) => {
          if (e.target.tagName !== "INPUT") {
            const cb = li.querySelector("input");
            cb.checked = !cb.checked;
          }
          const label = li.querySelector("label");
          if (li.querySelector("input").checked) {
            label.classList.add("line-through", "text-amber-200/40");
          } else {
            label.classList.remove("line-through", "text-amber-200/40");
          }
        });
        ingList.appendChild(li);
      });

      // Instructions
      const instList = document.getElementById("modal-instructions-list");
      instList.innerHTML = "";
      recipe.instructions.forEach((step) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-3 py-1";
        li.innerHTML = `
          <span class="w-6 h-6 rounded-full bg-[#E6A635]/20 border border-[#E6A635]/50 text-[#F5D061] font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 font-mono-recetario">
            ${step.step}
          </span>
          <span class="leading-relaxed text-amber-100 text-sm font-normal">${step.text}</span>
        `;
        instList.appendChild(li);
      });

      // Tip
      const tipBox = document.getElementById("modal-tip-box");
      const tipText = document.getElementById("modal-tip-text");
      if (recipe.tip) {
        tipText.textContent = recipe.tip;
        tipBox.classList.remove("hidden");
      } else {
        tipBox.classList.add("hidden");
      }

      recipeModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeRecipeModal() {
      recipeModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function openUnlockModal() {
      const err = document.getElementById("unlock-error");
      if (err) err.classList.add("hidden");
      unlockModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        document.getElementById("vip-input-code")?.focus();
      }, 50);
    }

    function closeUnlockModal() {
      unlockModal.classList.add("hidden");
      document.body.style.overflow = "";
    }

    // Filter Drawer Logic
    const drawerBackdrop = document.getElementById("filters-drawer-backdrop");
    const drawerPanel = document.getElementById("filters-drawer-panel");

    function openFilterDrawer() {
      if (!drawerBackdrop || !drawerPanel) return;
      drawerBackdrop.classList.remove("hidden");
      requestAnimationFrame(() => {
        drawerPanel.classList.remove(
          "translate-y-full",
          "sm:scale-95",
          "sm:opacity-0",
        );
        drawerPanel.classList.add(
          "translate-y-0",
          "sm:scale-100",
          "sm:opacity-100",
        );
      });
      document.body.style.overflow = "hidden";
    }

    function closeFilterDrawer() {
      if (!drawerBackdrop || !drawerPanel) return;
      drawerPanel.classList.add(
        "translate-y-full",
        "sm:scale-95",
        "sm:opacity-0",
      );
      drawerPanel.classList.remove(
        "translate-y-0",
        "sm:scale-100",
        "sm:opacity-100",
      );
      setTimeout(() => {
        drawerBackdrop.classList.add("hidden");
        document.body.style.overflow = "";
      }, 250);
    }

    // Synchronize visual buttons across desktop and mobile drawer
    function syncTagButtons() {
      const tagBtns = document.querySelectorAll(".filter-tag-btn");
      tagBtns.forEach((btn) => {
        const tag = btn.getAttribute("data-filter-tag");
        if (tag && activeTags.has(tag)) {
          btn.className =
            "filter-tag-btn text-xs font-bold px-3.5 py-2.5 bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] border border-[#FFF0C0] rounded-full whitespace-nowrap cursor-pointer transition-all shadow-md active:scale-95";
        } else {
          btn.className =
            "filter-tag-btn text-xs font-semibold px-3.5 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
        }
      });

      const drawerTagBtns = document.querySelectorAll(".drawer-tag-btn");
      drawerTagBtns.forEach((btn) => {
        const tag = btn.getAttribute("data-drawer-tag");
        const check = btn.querySelector(".tag-check");
        if (tag && activeTags.has(tag)) {
          btn.className =
            "drawer-tag-btn px-3.5 py-2 rounded-full border border-[#FFF0C0] bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer shadow-md";
          if (check) check.classList.remove("opacity-0");
        } else {
          btn.className =
            "drawer-tag-btn px-3.5 py-2 rounded-full border border-[#E6A635]/30 bg-[#1E0308] text-amber-100/90 font-medium text-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95";
          if (check) check.classList.add("opacity-0");
        }
      });
    }

    function syncFreeButtons() {
      const freeBtn = document.getElementById("filter-free-btn");
      if (freeBtn) {
        if (onlyFree) {
          freeBtn.className =
            "text-xs font-bold px-3.5 py-2.5 bg-emerald-500 text-white border border-emerald-300 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-[0_0_15px_rgba(52,211,153,0.4)] active:scale-95";
        } else {
          freeBtn.className =
            "text-xs font-bold px-3.5 py-2.5 bg-emerald-950/80 border border-emerald-400/60 text-emerald-300 hover:bg-emerald-600 hover:text-white rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95";
        }
      }

      const drawerFreeToggle = document.getElementById("drawer-free-toggle");
      const drawerFreeDot = document.getElementById("drawer-free-dot");
      if (drawerFreeToggle && drawerFreeDot) {
        if (onlyFree) {
          drawerFreeToggle.className =
            "w-full p-3 rounded-2xl border flex items-center justify-between transition-all bg-emerald-950/70 border-emerald-400/80 text-white cursor-pointer shadow-sm";
          drawerFreeDot.className =
            "w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]";
        } else {
          drawerFreeToggle.className =
            "w-full p-3 rounded-2xl border flex items-center justify-between transition-all bg-[#1E0308] border-[#E6A635]/30 text-amber-100 cursor-pointer active:scale-98";
          drawerFreeDot.className = "w-2.5 h-2.5 rounded-full bg-slate-500";
        }
      }
    }

    function syncCalorieButtons() {
      const calBtns = document.querySelectorAll(".cal-pill-btn");
      const calLabel = document.getElementById("drawer-calories-label");
      calBtns.forEach((btn) => {
        const range = btn.getAttribute("data-cal-range");
        if (calorieRange === range) {
          btn.className =
            "cal-pill-btn p-2.5 rounded-xl border text-center font-bold text-xs transition-all bg-[#E6A635] text-[#28050D] border-[#FFF0C0] shadow-sm cursor-pointer";
        } else {
          btn.className =
            "cal-pill-btn p-2.5 rounded-xl border text-center font-semibold text-xs transition-all bg-[#1E0308] text-amber-100/90 border-[#E6A635]/30 hover:border-[#F5D061] cursor-pointer";
        }
      });
      if (calLabel) {
        const labels = {
          all: "Todas",
          under100: "< 100 kcal",
          "100to200": "100–200 kcal",
          over200: "> 200 kcal",
        };
        calLabel.textContent = labels[calorieRange] || "Todas";
      }
    }

    // Filter Logic
    function applyFilters() {
      const articles = document.querySelectorAll(".recipe-card");
      let visibleCount = 0;

      articles.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const tags = card.getAttribute("data-tags") || "";
        const title = card.getAttribute("data-title") || "";
        const ingredients = card.getAttribute("data-ingredients") || "";
        const isFree = card.getAttribute("data-free") === "true";
        const cals = parseInt(card.getAttribute("data-calories") || "0", 10);

        // SI NO TIENE LA CONTRASEÑA (NO VIP), LAS RECETAS QUE NO SON DE MUESTRA QUEDAN COMPLETAMENTE OCULTAS
        if (!isVip && !isFree) {
          card.classList.add("hidden");
          return;
        }

        let matchesCat = activeCategory === "todas" || cat === activeCategory;
        let matchesTag =
          activeTags.size === 0 ||
          Array.from(activeTags).every((t) => tags.includes(t));
        let matchesFree = !onlyFree || isFree;
        let matchesCal = true;
        if (calorieRange === "under100") matchesCal = cals > 0 && cals < 100;
        else if (calorieRange === "100to200")
          matchesCal = cals >= 100 && cals <= 200;
        else if (calorieRange === "over200") matchesCal = cals > 200;

        let matchesSearch = true;
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          matchesSearch =
            title.includes(q) ||
            ingredients.includes(q) ||
            tags.toLowerCase().includes(q);
        }

        if (
          matchesCat &&
          matchesTag &&
          matchesFree &&
          matchesCal &&
          matchesSearch
        ) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      const countSpan = document.getElementById("count-visible");
      if (countSpan) {
        if (isVip) {
          countSpan.textContent = visibleCount;
        } else {
          countSpan.textContent = `${visibleCount} de muestra (179 bloqueadas)`;
        }
      }

      // Actualizar contador del botón del Drawer móvil
      const drawerApplyCount = document.getElementById("drawer-apply-count");
      if (drawerApplyCount) drawerApplyCount.textContent = visibleCount;

      // Actualizar insignia numérica de filtros activos
      let activeFiltersCount = 0;
      if (activeCategory !== "todas") activeFiltersCount++;
      if (activeTags.size > 0) activeFiltersCount += activeTags.size;
      if (onlyFree) activeFiltersCount++;
      if (calorieRange !== "all") activeFiltersCount++;
      if (searchQuery) activeFiltersCount++;

      const badge = document.getElementById("filter-badge-count");
      const btnOpenDrawer = document.getElementById("btn-open-filters-drawer");
      if (badge) {
        if (activeFiltersCount > 0) {
          badge.textContent = activeFiltersCount;
          badge.classList.remove("hidden");
          btnOpenDrawer?.classList.add(
            "border-[#F5D061]",
            "bg-[#4E0E1C]",
            "text-[#F5D061]",
            "shadow-[0_0_15px_rgba(230,166,53,0.3)]",
          );
        } else {
          badge.classList.add("hidden");
          btnOpenDrawer?.classList.remove(
            "border-[#F5D061]",
            "bg-[#4E0E1C]",
            "text-[#F5D061]",
            "shadow-[0_0_15px_rgba(230,166,53,0.3)]",
          );
        }
      }

      const emptyState = document.getElementById("empty-state");
      const recipesGrid = document.getElementById("recipes-grid");
      if (visibleCount === 0) {
        emptyState?.classList.remove("hidden");
        recipesGrid?.classList.add("hidden");
      } else {
        emptyState?.classList.add("hidden");
        recipesGrid?.classList.remove("hidden");
      }

      // Filter feedback
      const feedback = document.getElementById("filter-feedback");
      const feedbackText = document.getElementById("filter-feedback-text");
      const activeFilters = [];
      if (activeCategory !== "todas")
        activeFilters.push(`Categoría: ${activeCategory}`);
      if (activeTags.size > 0)
        activeFilters.push(`Etiquetas: ${Array.from(activeTags).join(", ")}`);
      if (onlyFree) activeFilters.push("Solo Muestras Gratis");
      if (calorieRange !== "all") {
        const calNames = {
          under100: "< 100 kcal",
          "100to200": "100–200 kcal",
          over200: "> 200 kcal",
        };
        activeFilters.push(
          `Calorías: ${calNames[calorieRange] || calorieRange}`,
        );
      }
      if (searchQuery) activeFilters.push(`Búsqueda: "${searchQuery}"`);

      if (activeFilters.length > 0 && feedback && feedbackText) {
        feedback.classList.remove("hidden");
        feedbackText.textContent = `FILTROS ACTIVOS: ${activeFilters.join(" | ")} (${visibleCount} recetas)`;
      } else if (feedback) {
        feedback.classList.add("hidden");
      }
    }

    // Event Listeners setup
    function initRecetario() {
      checkAuth();

      // VIP Toggle in header
      document
        .getElementById("btn-vip-header-pill")
        ?.addEventListener("click", () => {
          if (isVip) {
            openLogoutModal();
          } else {
            openUnlockModal();
          }
        });

      document
        .getElementById("btn-hero-unlock")
        ?.addEventListener("click", () => {
          openUnlockModal();
        });

      document
        .getElementById("btn-banner-unlock")
        ?.addEventListener("click", () => {
          openUnlockModal();
        });

      // Unlock modal form
      document
        .getElementById("unlock-form")
        ?.addEventListener("submit", (e) => {
          e.preventDefault();
          const input = document.getElementById("vip-input-code");
          const val = input ? input.value.trim() : "";
          const err = document.getElementById("unlock-error");

          if (val.toLowerCase() === VALID_PASSCODE.toLowerCase()) {
            setAuth(true);
            closeUnlockModal();
            showToast(
              "¡Acceso VIP Activado!",
              "Las 185 recetas completas han sido desbloqueadas con éxito.",
            );
          } else {
            if (err) err.classList.remove("hidden");
          }
        });

      document
        .getElementById("btn-close-unlock-modal")
        ?.addEventListener("click", closeUnlockModal);
      unlockModal?.addEventListener("click", (e) => {
        if (e.target === unlockModal) closeUnlockModal();
      });

      // Recipe modal triggers
      document.removeEventListener("click", handleDocumentClick);
      document.addEventListener("click", handleDocumentClick);

      document
        .getElementById("btn-close-modal")
        ?.addEventListener("click", closeRecipeModal);
      document
        .getElementById("btn-close-modal-bottom")
        ?.addEventListener("click", closeRecipeModal);
      recipeModal?.addEventListener("click", (e) => {
        if (e.target === recipeModal) closeRecipeModal();
      });

      // Escape key to close modals and drawer
      document.removeEventListener("keydown", handleDocumentKeydown);
      document.addEventListener("keydown", handleDocumentKeydown);

      // Filter Drawer triggers
      document
        .getElementById("btn-open-filters-drawer")
        ?.addEventListener("click", openFilterDrawer);
      document
        .getElementById("btn-close-filters-drawer")
        ?.addEventListener("click", closeFilterDrawer);
      document
        .getElementById("btn-drawer-apply")
        ?.addEventListener("click", closeFilterDrawer);
      drawerBackdrop?.addEventListener("click", (e) => {
        if (e.target === drawerBackdrop) closeFilterDrawer();
      });

      // Reset filters logic
      const resetFilters = () => {
        activeCategory = "todas";
        activeTags.clear();
        onlyFree = false;
        calorieRange = "all";
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        clearBtn?.classList.add("hidden");

        const catBtns = document.querySelectorAll(".cat-tab-btn");
        catBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.className =
              "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]";
          } else {
            b.className =
              "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]";
          }
        });

        syncTagButtons();
        syncFreeButtons();
        syncCalorieButtons();
        applyFilters();
      };

      // Calorie pills in Drawer
      const calBtns = document.querySelectorAll(".cal-pill-btn");
      calBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          calorieRange = btn.getAttribute("data-cal-range") || "all";
          syncCalorieButtons();
          applyFilters();
        });
      });

      // Drawer Tags
      const drawerTagBtns = document.querySelectorAll(".drawer-tag-btn");
      drawerTagBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-drawer-tag");
          if (!tag) return;
          if (activeTags.has(tag)) {
            activeTags.delete(tag);
          } else {
            activeTags.add(tag);
          }
          syncTagButtons();
          applyFilters();
        });
      });

      // Drawer Free Toggle
      document
        .getElementById("drawer-free-toggle")
        ?.addEventListener("click", () => {
          onlyFree = !onlyFree;
          syncFreeButtons();
          applyFilters();
        });

      // Drawer Reset Button
      document
        .getElementById("btn-drawer-reset")
        ?.addEventListener("click", resetFilters);

      // Category tab buttons
      const catBtns = document.querySelectorAll(".cat-tab-btn");
      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => {
            b.className =
              "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]";
          });
          btn.className =
            "cat-tab-btn text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]";

          activeCategory = btn.getAttribute("data-category") || "todas";
          applyFilters();
        });
      });

      // Tag filter buttons (Desktop quick chips)
      const tagBtns = document.querySelectorAll(".filter-tag-btn");
      tagBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-filter-tag");
          if (!tag) return;
          if (activeTags.has(tag)) {
            activeTags.delete(tag);
          } else {
            activeTags.add(tag);
          }
          syncTagButtons();
          applyFilters();
        });
      });

      // Free filter button (Desktop quick chip)
      const freeBtn = document.getElementById("filter-free-btn");
      freeBtn?.addEventListener("click", () => {
        onlyFree = !onlyFree;
        syncFreeButtons();
        applyFilters();
      });

      // Search input
      const searchInput = document.getElementById("recipe-search");
      const clearBtn = document.getElementById("clear-search-btn");
      searchInput?.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim();
        if (searchQuery) {
          clearBtn?.classList.remove("hidden");
        } else {
          clearBtn?.classList.add("hidden");
        }
        applyFilters();
      });

      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        clearBtn.classList.add("hidden");
        applyFilters();
      });

      document
        .getElementById("reset-all-filters")
        ?.addEventListener("click", resetFilters);
      document
        .getElementById("btn-reset-empty")
        ?.addEventListener("click", resetFilters);

      // Sincronización del offset sticky del buscador respecto al header fijo
      const filterBar = document.getElementById("search-filter-bar");
      const fixedHeader = document.querySelector("header.fixed");
      function updateStickyOffset() {
        if (fixedHeader && filterBar) {
          const h = fixedHeader.getBoundingClientRect().height;
          filterBar.style.top = `${Math.round(h)}px`;
        }
      }
      updateStickyOffset();
      window.addEventListener("resize", updateStickyOffset, { passive: true });
      window.addEventListener("scroll", updateStickyOffset, { passive: true });
    }

    function handleDocumentClick(e) {
      const btn = e.target.closest('[data-action="open-recipe"]');
      if (btn) {
        const recipeId = btn.getAttribute("data-recipe-id");
        if (recipeId) openRecipeModal(recipeId);
      }
    }

    function handleDocumentKeydown(e) {
      if (e.key === "Escape") {
        closeRecipeModal();
        closeUnlockModal();
        closeLogoutModal();
        closeFilterDrawer();
      }
    }

    let hasLoaded = false;
    function safeInit() {
      if (hasLoaded) return;
      hasLoaded = true;
      initRecetario();
    }

    document.addEventListener("astro:page-load", () => {
      hasLoaded = false;
      safeInit();
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", safeInit, { once: true });
    } else {
      safeInit();
    }
  </script>
</Layout>
