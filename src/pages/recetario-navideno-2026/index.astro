---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import recipesData from "../../data/recipes.json";
import HolidayEffects from "../../components/HolidayEffects.astro";

// Free preview sample recipe IDs (one per major chapter, 6 in total)
const FREE_SAMPLE_IDS = [
  "001-champurrado-ligero",
  "042-ensalada-campera",
  "084-lomo-de-cerdo-con-champinones",
  "125-pure-de-camote-con-canela",
  "151-trufas-de-datil-y-cacao",
  "176-mousse-de-aguacate-y-cacao",
];

const totalRecipes = recipesData.length;
const categoryCounts = recipesData.reduce(
  (acc, r) => {
    acc[r.categorySlug] = (acc[r.categorySlug] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const categories = [
  { name: "Todas", slug: "todas", count: totalRecipes },
  { name: "Bebidas", slug: "bebidas", count: categoryCounts["bebidas"] || 0 },
  {
    name: "Ensaladas",
    slug: "ensaladas",
    count: categoryCounts["ensaladas"] || 0,
  },
  {
    name: "Platos Fuertes",
    slug: "platos-fuertes",
    count: categoryCounts["platos-fuertes"] || 0,
  },
  {
    name: "Guarniciones",
    slug: "guarniciones",
    count: categoryCounts["guarniciones"] || 0,
  },
  { name: "Postres", slug: "postres", count: categoryCounts["postres"] || 0 },
  {
    name: "Diabetes",
    slug: "diabetes",
    count: categoryCounts["diabetes"] || 0,
  },
];

// Color contours and badges by category matching the holiday aesthetic
function getCategoryContour(slug: string) {
  switch (slug) {
    case "bebidas":
      return {
        border: "border-rose-400/40 hover:border-rose-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(251,113,133,0.18)]",
        badge: "bg-rose-500/15 text-rose-300 border-rose-400/30",
        accent: "#FB7185",
        label: "Bebidas",
      };
    case "ensaladas":
      return {
        border: "border-emerald-400/40 hover:border-emerald-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(52,211,153,0.18)]",
        badge: "bg-emerald-500/15 text-emerald-300 border-emerald-400/30",
        accent: "#34D399",
        label: "Ensaladas",
      };
    case "platos-fuertes":
      return {
        border: "border-red-400/40 hover:border-red-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(248,113,113,0.18)]",
        badge: "bg-red-500/15 text-red-300 border-red-400/30",
        accent: "#F87171",
        label: "Platos Fuertes",
      };
    case "guarniciones":
      return {
        border: "border-orange-400/40 hover:border-orange-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(251,146,60,0.18)]",
        badge: "bg-orange-500/15 text-orange-300 border-orange-400/30",
        accent: "#FB923C",
        label: "Guarniciones",
      };
    case "postres":
      return {
        border: "border-amber-400/40 hover:border-amber-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(245,208,97,0.18)]",
        badge: "bg-amber-500/15 text-amber-300 border-amber-400/30",
        accent: "#F5D061",
        label: "Postres",
      };
    case "diabetes":
      return {
        border: "border-cyan-400/40 hover:border-cyan-400/75",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(34,211,238,0.18)]",
        badge: "bg-cyan-500/15 text-cyan-300 border-cyan-400/30",
        accent: "#22D3EE",
        label: "Diabetes",
      };
    default:
      return {
        border: "border-[#E6A635]/35 hover:border-[#F5D061]/70",
        glow: "hover:shadow-[0_12px_32px_rgba(0,0,0,0.6),0_0_22px_rgba(230,166,53,0.18)]",
        badge: "bg-[#E6A635]/15 text-[#F5D061] border-[#E6A635]/30",
        accent: "#F5D061",
        label: "Receta",
      };
  }
}
---

<Layout
  title="Recetario Navideño 2026 · Edición Clínica | Nutrilev"
  description="185 recetas navideñas con respaldo clínico, porciones controladas y conteo de equivalentes SMAE por la Nutrióloga Velvet De la Cruz."
  hideFloatingCTA={true}
>
  <!-- Google Fonts: Script, Playfair Display, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />

  <style is:inline>
    .font-script {
      font-family: "Dancing Script", cursive, sans-serif;
    }
    .font-display {
      font-family: "Playfair Display", Georgia, serif;
    }
    .font-sans-recetario {
      font-family:
        "Plus Jakarta Sans",
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;
    }
    .font-mono-recetario {
      font-family: "JetBrains Mono", ui-monospace, monospace;
    }

    /* Festive background pattern with subtle snowflake watermarks */
    .bg-holiday-canvas {
      background: radial-gradient(
        circle at 15% 10%,
        #520f1c 0%,
        #350811 50%,
        #20040a 100%
      );
      background-attachment: fixed;
    }

    /* Asegurar fondo vino festivo y título dorado permanentemente visible en tarjetas */
    .recipe-card {
      background-color: #28050d !important;
      color: #ffffff !important;
    }
    .recipe-card h3 {
      color: #f5d061 !important;
    }
    .recipe-card:hover h3 {
      color: #ffffff !important;
    }

    /* Custom print styles for recipe detail */
    @media print {
      header,
      nav,
      footer,
      #filter-section,
      #vip-banner,
      .no-print {
        display: none !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      #recipe-modal {
        position: static !important;
        background: none !important;
        padding: 0 !important;
      }
      #recipe-modal-dialog {
        box-shadow: none !important;
        border: none !important;
        max-width: 100% !important;
        width: 100% !important;
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <!-- MISMO HEADER / NAVBAR QUE TODA LA PÁGINA WEB -->
  <Navbar />

  <!-- CONTENEDOR PRINCIPAL CON EL FONDO NAVIDEÑO DE LA IMAGEN (VINO PROFUNDO Y DESTELLOS DORADOS) -->
  <div class="bg-holiday-canvas text-white pt-32 sm:pt-36 md:pt-44 lg:pt-48 pb-20 min-h-screen relative overflow-x-clip font-sans-recetario selection:bg-[#E6A635] selection:text-[#2E060E]">
    <!-- EFECTOS NAVIDEÑOS MODULARES 2026 (NIEVE, ESFERAS, TRINEO Y CONTROL) -->
    <HolidayEffects />

    <!-- Ambient Christmas botanical glowing lights -->
    <div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-red-600/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-80 right-10 w-[450px] h-[450px] bg-amber-500/10 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-40 left-10 w-[550px] h-[550px] bg-emerald-600/10 rounded-full blur-[150px] pointer-events-none"></div>

    <!-- HERO EDITORIAL FESTIVO -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 md:pt-10 pb-12 sm:pb-16 relative z-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Headline & Manifesto -->
        <div class="lg:col-span-7">
          <!-- Holiday Festive Tag (Sin emojis) -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E6A635]/10 border border-[#E6A635]/30 text-[#F5D061] text-xs font-semibold tracking-wide mb-5 backdrop-blur-md">
            <span>Edición Navideña 2026</span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl lg:text-5.5xl text-white font-bold leading-[1.12] tracking-tight mb-5">
            El arte de celebrar con bienestar:{" "}
            <span class="font-script text-4xl sm:text-6xl lg:text-7xl text-[#F5D061] block font-normal mt-1">
              185 recetas navideñas
            </span>{" "}
            con respaldo clínico.
          </h1>

          <p class="text-amber-100/80 text-base sm:text-lg leading-relaxed max-w-2xl font-light">
            Recetario exclusivo desarrollado por la{" "}
            <strong class="text-white font-semibold">
              Nutrióloga Velvet De la Cruz Villegas
            </strong>{" "}
            (Céd. Prof. 10622381) para disfrutar las cenas decembrinas con
            equilibrio metabólico, cálculo de porciones y equivalentes del{" "}
            <strong>SMAE</strong> y alternativas seguras para personas con
            diabetes.
          </p>
        </div>

        <!-- Right: VIP Card refinada (Sin caja dentro de caja, borde fino elegante) -->
        <div class="lg:col-span-5 rounded-2xl border border-[#E6A635]/35 bg-[#2B050D]/90 backdrop-blur-md p-6 sm:p-8 shadow-[0_10px_40px_rgba(0,0,0,0.4)]">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E6A635]/20">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#F5D061]">
              Recetario Navideño Completo
            </span>
            <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full border border-[#E6A635]/35 text-[#F5D061] bg-[#E6A635]/10">
              Edición 2026
            </span>
          </div>

          <div id="hero-vip-locked">
            <h2 class="font-display text-2xl text-white font-bold mb-2">
              Desbloquea las 185 Recetas
            </h2>
            <p class="text-amber-100/75 text-sm leading-relaxed mb-6 font-light">
              Tienes <strong>6 recetas de muestra gratuitas</strong>{" "}
              disponibles. Para tener acceso ilimitado a las 185 recetas
              completas con fotografías, porciones e información nutricional,
              ingresa tu código o adquiérelo por WhatsApp.
            </p>

            <div class="space-y-3">
              <!-- Botón primario: Ingresar Código de Acceso (Elegante dorado sólido con icono fino) -->
              <button
                type="button"
                id="btn-hero-unlock"
                class="w-full py-3.5 px-5 bg-gradient-to-r from-[#E6A635] to-[#D49522] hover:from-[#F5D061] hover:to-[#E6A635] text-[#28050D] font-bold text-xs uppercase tracking-wider rounded-xl transition-all duration-200 shadow-md hover:shadow-[0_4px_20px_rgba(230,166,53,0.35)] active:scale-98 cursor-pointer flex items-center justify-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-[#28050D]"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"
                  />
                </svg>
                <span>Ingresar Código de Acceso</span>
              </button>

              <!-- Botón secundario: Comprar por WhatsApp (Color verde característico #25D366 con icono oficial) -->
              <a
                href="https://wa.me/526143958598?text=Hola%20Nutri%C3%B3loga%20Velvet,%20me%20interesa%20adquirir%20el%20Recetario%20Navide%C3%B1o%202026%20completo%20(185%20recetas)."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3.5 px-5 bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all duration-200 shadow-md hover:shadow-[0_4px_20px_rgba(37,211,102,0.35)] active:scale-98 text-center flex items-center justify-center gap-2"
              >
                <svg
                  class="w-4 h-4 fill-current shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                <span>Comprar Acceso por WhatsApp</span>
              </a>
            </div>
          </div>

          <div id="hero-vip-unlocked" class="hidden">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-500/15 border border-emerald-400/35 text-emerald-300 rounded-full text-xs font-semibold mb-3">
              <svg
                class="w-3.5 h-3.5 text-emerald-400"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 12.75l6 6 9-13.5"
                />
              </svg>
              <span>SESIÓN VIP AUTORIZADA</span>
            </div>
            <h2 class="font-display text-2xl text-white font-bold mb-2">
              ¡Bienvenido a tu Recetario Completo!
            </h2>
            <p class="text-amber-100/75 text-sm mb-6 font-light">
              Tienes acceso total a las 185 recetas con fotografías en alta
              definición, tabla de equivalentes clínicos del SMAE y buscador
              interactivo.
            </p>
            <div class="p-3.5 bg-[#1E0308] border border-[#E6A635]/30 rounded-xl text-xs font-semibold text-white flex items-center justify-between">
              <span class="text-[#E6A635]">ESTADO:</span>
              <span class="text-emerald-400 font-bold font-mono-recetario">
                185 RECETAS ACTIVAS
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BARRA DE CONTROLES, BÚSQUEDA Y FILTROS ESTILIZADA (STICKY EN MÓVIL Y ESCRITORIO) -->
    <section
      id="search-filter-bar"
      class="border-y border-[#E6A635]/25 bg-[#2B050D]/95 backdrop-blur-xl sticky top-[112px] sm:top-[116px] z-30 shadow-xl transition-all"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3.5">
        <!-- Top Row: Compact Search + Mobile Filter Trigger + Desktop Quick Chips -->
        <div class="flex items-center gap-2.5 sm:gap-3.5 mb-2.5">
          <!-- Search Input with Clear Button -->
          <div class="relative flex-1 group">
            <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#8B1A2B] group-focus-within:text-[#B87A1E] pointer-events-none transition-colors">
              <svg
                class="w-4.5 h-4.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                ></path>
              </svg>
            </div>
            <input
              id="recipe-search"
              type="search"
              placeholder="Buscar receta o ingrediente..."
              class="w-full h-11 sm:h-12 pl-10 sm:pl-11 pr-10 bg-[#FFFDF7] hover:bg-white focus:bg-white border-2 border-[#E6A635] focus:border-[#C48825] focus:ring-4 focus:ring-[#E6A635]/25 rounded-xl sm:rounded-2xl text-xs sm:text-sm text-[#28050D] font-medium placeholder-[#8C6D48] focus:outline-none transition-all shadow-md [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
            />
            <button
              id="clear-search-btn"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-[#28050D]/10 hover:bg-[#28050D]/20 text-[#28050D] flex items-center justify-center text-[10px] font-bold transition-colors cursor-pointer"
              title="Borrar búsqueda"
            >
              ✕
            </button>
          </div>

          <!-- Botón de Filtros Táctil (Oculto temporalmente) -->
          <button
            id="btn-open-filters-drawer"
            type="button"
            class="hidden h-11 sm:h-12 px-3.5 sm:px-4 bg-[#3B0B14] hover:bg-[#4E0E1C] active:scale-95 border border-[#E6A635]/40 hover:border-[#F5D061] text-amber-100 rounded-xl sm:rounded-2xl font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm shrink-0 cursor-pointer"
            title="Abrir filtros avanzados"
          >
            <svg
              class="w-4 h-4 text-[#F5D061]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
              ></path>
            </svg>
            <span class="hidden xs:inline">Filtros</span>
            <span
              id="filter-badge-count"
              class="hidden px-1.5 py-0.2 rounded-full text-[10px] font-extrabold bg-[#E6A635] text-[#28050D] shadow-sm font-mono-recetario"
            >
              0
            </span>
          </button>

          <!-- Desktop Quick Filter Chips (Solo pantallas medianas y grandes) -->
          <div class="hidden md:flex items-center gap-2">
            <button
              type="button"
              data-filter-tag="Sin azúcar añadida"
              class="filter-tag-btn text-xs font-semibold px-3.5 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Sin azúcar
            </button>
            <button
              type="button"
              data-filter-tag="Baja en grasa"
              class="filter-tag-btn text-xs font-semibold px-3.5 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Baja en grasa
            </button>
            <button
              type="button"
              data-filter-tag="Rica en proteína"
              class="filter-tag-btn text-xs font-semibold px-3.5 py-2.5 bg-[#3B0B14] border border-[#E6A635]/30 hover:border-[#F5D061] text-amber-100/90 rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Con proteína
            </button>
            <button
              type="button"
              data-filter-free="true"
              id="filter-free-btn"
              class="text-xs font-medium px-3.5 py-2 bg-emerald-950/70 border border-emerald-400/40 text-emerald-300 hover:bg-emerald-600 hover:text-white rounded-full whitespace-nowrap cursor-pointer transition-all shadow-sm active:scale-95"
            >
              Muestras gratuitas (6)
            </button>
          </div>
        </div>

        <!-- Bottom Row: Category Tabs con cinta única de scroll táctil fluido -->
        <div class="flex items-center justify-between gap-3 overflow-x-auto scrollbar-none py-1 -mx-4 px-4 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-1.5 sm:gap-2 flex-nowrap">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat.slug}
                class={`cat-tab-btn text-xs font-bold px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full whitespace-nowrap transition-all duration-300 cursor-pointer border ${
                  idx === 0
                    ? "bg-gradient-to-r from-[#E6A635] to-[#D49522] text-[#28050D] font-extrabold shadow-[0_0_15px_rgba(230,166,53,0.4)] border-[#FFF0C0]"
                    : "bg-[#25040B]/80 text-amber-100/80 border-[#E6A635]/30 hover:border-[#F5D061] hover:text-[#F5D061] hover:bg-[#380A13]"
                }`}
              >
                <span>{cat.name}</span>
                <span class="opacity-80 ml-1 text-[11px] font-mono-recetario">
                  ({cat.count})
                </span>
              </button>
            ))}
          </div>

          <div class="hidden lg:flex items-center gap-3 text-xs text-amber-200/70 whitespace-nowrap shrink-0">
            <span>
              Visibles:{" "}
              <strong
                id="count-visible"
                class="text-[#F5D061] font-mono-recetario font-bold"
              >
                185
              </strong>{" "}
              / 185
