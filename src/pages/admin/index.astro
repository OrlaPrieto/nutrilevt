---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Panel de Administración | Nutrilev">
  <div class="min-h-screen bg-slate-900 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-accent/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="sm:mx-auto sm:w-full sm:max-w-md relative z-10">
      <div class="text-center mb-8">
        <a href="/" class="inline-block text-2xl font-serif font-bold text-white tracking-wide">
          NUTRILEV<span class="text-primary">.</span>
        </a>
        <h1 class="mt-4 text-2xl font-bold text-white tracking-tight">
          Panel de Administración
        </h1>
        <p class="mt-2 text-sm text-slate-400">
          Inicia sesión para gestionar las publicaciones del blog
        </p>
      </div>

      <div class="bg-slate-800/80 backdrop-blur-xl border border-slate-700/80 py-8 px-6 shadow-2xl rounded-3xl sm:px-10">
        <!-- Error / Info Alert -->
        <div id="login-alert" class="hidden mb-6 p-4 rounded-2xl text-sm font-medium"></div>

        <form id="login-form" class="space-y-6">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
              Correo Electrónico
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="tu-correo@nutrilev.com"
              class="w-full px-4 py-3.5 bg-slate-900/90 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-sm"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
              Contraseña
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="••••••••••••"
              class="w-full px-4 py-3.5 bg-slate-900/90 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-sm"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 px-4 bg-primary hover:bg-primary-hover text-white font-bold rounded-xl text-sm shadow-lg shadow-pink-950/50 hover:shadow-pink-900/80 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Iniciar Sesión</span>
            <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-700/60 text-center">
          <a href="/" class="text-xs text-slate-400 hover:text-primary transition-colors inline-flex items-center gap-1">
            <span>← Volver al sitio web principal</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";
  import { checkIsBlogAdmin } from "../../lib/blog";

  async function checkExistingSession() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      const isAdmin = await checkIsBlogAdmin();
      if (isAdmin) {
        window.location.href = '/admin/blog';
      }
    }
  }

  function initLogin() {
    checkExistingSession();

    const form = document.getElementById('login-form') as HTMLFormElement;
    const alertBox = document.getElementById('login-alert') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      if (!email || !password) return;

      // Loading state
      submitBtn.disabled = true;
      btnText.innerText = 'Verificando...';
      btnSpinner.classList.remove('hidden');
      alertBox.classList.add('hidden');

      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-medium bg-red-900/50 border border-red-700/60 text-red-200';
          alertBox.innerText = error.message === 'Invalid login credentials' 
            ? 'Credenciales incorrectas. Verifica tu correo y contraseña.' 
            : `Error: ${error.message}`;
          alertBox.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.innerText = 'Iniciar Sesión';
          btnSpinner.classList.add('hidden');
          return;
        }

        if (data.session) {
          // Verificar si el usuario está autorizado en la tabla blog_admins
          const isAdmin = await checkIsBlogAdmin();
          if (!isAdmin) {
            await supabase.auth.signOut();
            alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-medium bg-red-900/50 border border-red-700/60 text-red-200';
            alertBox.innerText = 'Acceso denegado: Tu cuenta no tiene permisos de administrador para este portal.';
            alertBox.classList.remove('hidden');
            submitBtn.disabled = false;
            btnText.innerText = 'Iniciar Sesión';
            btnSpinner.classList.add('hidden');
            return;
          }

          window.location.href = '/admin/blog';
        }
      } catch (err: any) {
        alertBox.className = 'mb-6 p-4 rounded-2xl text-sm font-medium bg-red-900/50 border border-red-700/60 text-red-200';
        alertBox.innerText = err.message || 'Error inesperado al conectar con Supabase.';
        alertBox.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText.innerText = 'Iniciar Sesión';
        btnSpinner.classList.add('hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', initLogin);
  initLogin();
</script>
